# Imagen de desarrollo — NestJS con HMR (nest start --watch)
# No usar en produccion; para produccion usar Dockerfile (multi-stage).
#
# El codigo fuente se monta como volumen en docker-compose.yml:
#   - ./apps/erp-monolithic-api:/app        (codigo del host)
#   - api_node_modules:/app/node_modules    (deps del contenedor, no del host)
FROM node:22-alpine
WORKDIR /app

# OpenSSL requerido por el motor de consultas de Prisma en Alpine (musl)
RUN apk add --no-cache openssl

# Instala dependencias desde los manifests (antes de montar el volumen)
COPY package*.json ./
COPY apps/api/package*.json ./apps/api/
RUN npm ci

# Genera el cliente Prisma en el contexto de la imagen (linux-musl)
COPY apps/api/prisma ./apps/api/prisma
RUN npx prisma generate --schema=apps/api/prisma/schema.prisma

EXPOSE 3000

# Aplica migraciones pendientes y arranca en modo watch
CMD ["sh", "-c", "npx prisma migrate deploy --schema=apps/api/prisma/schema.prisma && npm run dev:api"]
