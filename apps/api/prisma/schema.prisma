// Prisma schema baseline - KAIROS/VeloxRent ERP
// Fuente: TDD-KAIROS-TRANSVERSAL.md, secciones 7.1, 7.3, 7.4
// Este archivo cubre unicamente las tablas transversales compartidas
// (idempotency_keys, outbox_events, audit_events, vehicle_commitments).
// Las entidades de dominio por modulo (Reserva, Alquiler, Devolucion,
// Consulta, Reclutamiento, Administracion de Personal) se agregan de
// forma incremental, pantalla a pantalla, segun TDD-<MOD>-001.md.

generator client {
  provider      = "prisma-client-js"
  // linux-musl-arm64-openssl-3.0.x = Alpine (node:22-alpine) con openssl 3.x en ARM64
  // linux-musl-openssl-3.0.x       = Alpine con openssl 3.x en x86_64 (Cloud Run)
  // native                          = desarrollo local (mac, linux host)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // directUrl se usa exclusivamente para migraciones DDL que no pueden
  // correr sobre PgBouncer en modo transaction (requerido por Supabase).
  directUrl = env("DIRECT_URL")
}

/// TDD-KAIROS-TRANSVERSAL.md 7.3 - deduplicacion de comandos idempotentes
/// Hallazgo ALTO de revision PR#6 ("idempotencia no implementada"):
/// este modelo ya existia desde el init (20260918000000) pero nunca se
/// conecto a ningun endpoint - IdempotencyInterceptor (common/http) lo
/// usa ahora para los comandos de escritura de Reserva.
/// organizationId ahora es opcional (antes NOT NULL,
/// 20260922010000_idempotency_keys_optional_org): el interceptor corre a
/// nivel HTTP, ANTES de que el handler resuelva el contexto de trabajo
/// autorizado (WorkContextAuthorizationService), asi que todavia no se
/// conoce el organizationId real en el momento de guardar la clave - se
/// guarda null y se completa mas adelante si en el futuro el
/// interceptor se reubica despues de la autorizacion.
model IdempotencyKey {
  id             String   @id @default(uuid())
  key            String   @unique
  organizationId String?  @map("organization_id")
  requestHash    String   @map("request_hash")
  responseBody   Json?    @map("response_body")
  statusCode     Int?     @map("status_code")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  @@index([expiresAt], map: "idempotency_keys_expires_at_idx")
  @@map("idempotency_keys")
}

/// TDD-KAIROS-TRANSVERSAL.md 7.3 - outbox pattern para eventos de dominio
model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at")
  processedAt   DateTime? @map("processed_at")

  /// Hallazgo ALTO de revalidacion PR#7 ("outbox sin fiabilidad real",
  /// ver migracion 20260924020000_outbox_event_reliability): `attempts`
  /// respalda el backoff exponencial, `lockedUntil` es el arriendo
  /// (lease) que hace seguro reclamar eventos entre replicas (claim
  /// atomico via SQL crudo, no expuesto como metodo tipado de Prisma
  /// Client todavia), `lastError` es el motivo del ultimo fallo (para
  /// diagnostico manual) y `deadLetteredAt` marca un evento que agoto
  /// sus reintentos - deja de reclamarse pero NUNCA se borra (requiere
  /// intervencion manual, mismo criterio de nunca perder historial que
  /// el resto del backend).
  attempts       Int       @default(0)
  lockedUntil    DateTime? @map("locked_until")
  lastError      String?   @map("last_error")
  deadLetteredAt DateTime? @map("dead_lettered_at")

  @@index([processedAt])
  @@index([deadLetteredAt], map: "outbox_events_dead_lettered_at_idx")
  @@index([aggregateType, processedAt, deadLetteredAt, lockedUntil, createdAt], map: "outbox_events_claim_idx")
  @@map("outbox_events")
}

/// TDD-KAIROS-TRANSVERSAL.md 7.3 - bitacora de auditoria, reutilizada por
/// los 6 modulos (no se duplica una tabla de auditoria por modulo)
/// ADM-03 (Catalogos y parametros, PANTALLAS-V2-B-SOPORTE.md) - primera
/// version real de un parametro versionado: reemplaza el valor fijo en
/// codigo documentado en reservation-deposit-policy.ts (BR-RES-001,
/// docs/decision-log.md PROP-005). "Solo una version vigente a la vez"
/// (contrato ADM-03 punto 8): la vigente es la de mayor `version` para
/// la organizacion - nunca se edita ni se borra una fila existente, cada
/// cambio inserta una version nueva (contrato punto 11, historial).
model ReservationDepositPolicyVersion {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  version        Int
  amount         Decimal  @db.Decimal(12, 2)
  currency       String   @db.Char(3)
  effectiveFrom  DateTime @default(now()) @map("effective_from")
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String   @map("created_by")

  @@unique([organizationId, version])
  @@map("reservation_deposit_policy_versions")
}

/// ADM-02 (Roles y permisos, PANTALLAS-V2-B-SOPORTE.md) - primera
/// version real de una matriz rol-accion versionada. Persiste una foto
/// completa (todas las celdas) por cada version guardada - "solo una
/// version vigente a la vez" (contrato punto 9, READY/DIRTY/SAVING):
/// la vigente es la de mayor `version` para la organizacion.
///
/// IMPORTANTE (alcance real, ver role-permission-matrix.port.ts): esta
/// tabla es hoy de solo VISUALIZACION Y AUDITORIA del cambio - los
/// archivos `*-role-policy.ts` (reservation-role-policy.ts,
/// inquiry-role-policy.ts, admin-role-policy.ts) siguen siendo el punto
/// real de enforcement en cada handler. Reemplazarlos por una consulta a
/// esta tabla es trabajo futuro (requiere revisar cada handler uno por
/// uno, no se hace en el mismo corte que la pantalla).
///
/// ROLES DINAMICOS (fase 2, ver claude/Diseno_Roles_Dinamicos_y_Permisos.md):
/// la celda se identifica por `roleId` (tabla `roles`), ya no por el enum
/// WorkerRole; la columna `role` queda DEPRECADA (nullable, nadie la lee ni
/// la escribe, se retira en un PR posterior). Cada version es una foto
/// completa de UN ambito: `companyId`/`branchId` NULL = toda la
/// organizacion; `companyId` solo = toda la empresa; ambos = esa sede. La
/// numeracion de `version` es unica por organizacion (compartida entre
/// ambitos). Resolucion en tiempo de autorizacion: gana el ambito mas
/// especifico (sede > empresa > organizacion); sin entrada = denegado.
model RolePermissionMatrixVersion {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  version        Int
  /// DEPRECADA (roles dinamicos): reemplazada por `roleId`. No se lee ni se escribe.
  role           WorkerRole?
  roleId         String      @map("role_id")
  /// Ambito de la version (NULL = toda la organizacion).
  companyId      String?     @map("company_id")
  branchId       String?     @map("branch_id")
  action         String
  allowed        Boolean
  createdAt      DateTime    @default(now()) @map("created_at")
  createdBy      String      @map("created_by")

  roleRecord Role    @relation(fields: [roleId, organizationId], references: [id, organizationId], map: "role_permission_matrix_versions_role_id_organization_id_fkey")
  company    Company? @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade, map: "role_permission_matrix_versions_company_id_organization_id_fkey")
  branch     Branch?  @relation(fields: [branchId, companyId], references: [id, companyId], onDelete: Restrict, onUpdate: Cascade, map: "role_permission_matrix_versions_branch_id_company_id_fkey")

  @@unique([organizationId, version, roleId, action], map: "role_permission_matrix_org_version_role_id_action_key")
  @@index([organizationId, companyId, branchId, version], map: "role_permission_matrix_versions_scope_version_idx")
  @@map("role_permission_matrix_versions")
}

/// ROLES DINAMICOS (fase 2): un rol es un DATO de la organizacion, no un
/// enum. Los 8 valores historicos de WorkerRole se siembran como roles de
/// sistema (`isSystem`, con `key` estable = valor del enum); los creados a
/// mano tienen `key` NULL. `PLATFORM_ADMIN` no se renombra, no se
/// desactiva y su fila de la matriz no se edita desde ADM-02. Nunca se
/// borra un rol (historial): se desactiva. `version` es la concurrencia
/// optimista de renombrar/desactivar (ETag/If-Match).
///
/// Unicidad del nombre sin distinguir mayusculas: indice unico FUNCIONAL
/// `roles_organization_id_lower_name_key` (organization_id, lower(name)),
/// solo en SQL (Prisma no modela indices de expresion; los ignora en
/// `migrate diff`, mismo caso que contract_template_unique_active).
model Role {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  key            String?
  name           String
  isSystem       Boolean  @default(false) @map("is_system")
  active         Boolean  @default(true)
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  assignments   UserCompanyAssignment[]
  matrixEntries RolePermissionMatrixVersion[]

  /// Soporte de las FK compuestas (roleId, organizationId) -> Role(id,
  /// organizationId): la base impide asignar/permitir un rol de OTRA organizacion.
  @@unique([id, organizationId], map: "roles_id_organization_id_key")
  @@unique([organizationId, key], map: "roles_organization_id_key_key")
  @@index([organizationId, active], map: "roles_organization_id_active_idx")
  @@map("roles")
}

/// ADM-05 (PANTALLAS-V2-B-SOPORTE.md) - plantilla de notificacion por
/// evento de dominio, versionada (misma disciplina que
/// ReservationDepositPolicyVersion / RolePermissionMatrixVersion:
/// nunca se edita/borra una version, se inserta la siguiente).
///
/// ALCANCE REAL: esto configura el TEXTO y el/los canal(es) de una
/// plantilla - no envia nada todavia. El envio real (TR-07, outbox de
/// notificaciones) sigue sin construirse; ver
/// claude/Diseno_Agregador_Transversal_TR-06-07-08.md. `eventType` solo
/// admite eventos que YA se publican de verdad en outbox_events
/// (ReservationCreated/Confirmed/Cancelled) - no se inventan eventos
/// que el sistema no emite.
model NotificationTemplateVersion {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  eventType      String   @map("event_type")
  version        Int
  channels       String[]
  body           String
  createdAt      DateTime @default(now()) @map("created_at")
  createdBy      String   @map("created_by")

  @@unique([organizationId, eventType, version])
  @@map("notification_template_versions")
}

/// TR-07 (Centro de notificaciones, PANTALLAS-V2-B-TRANSVERSAL.md) -
/// proyeccion de lectura de notificaciones por usuario, consumida desde
/// el mismo outbox transaccional que TR-06 (ver
/// claude/Diseno_Agregador_Transversal_TR-06-07-08.md). Idempotente por
/// sourceEventId - reprocesar el mismo evento no duplica la fila.
///
/// ALCANCE REAL: el destinatario (`recipientFirebaseUid`) es siempre
/// quien ejecuto la accion que genero el evento (createdBy/confirmedBy/
/// cancelledBy en el payload de Reservation) - es una bitacora personal
/// de "lo que hiciste", no todavia una notificacion dirigida a un
/// tercero (ej. avisarle a Finanzas que una reserva se confirmo)
/// porque el sistema no modela destinatarios distintos del actor para
/// estos eventos hoy. `isEscalated` queda siempre en false: el contrato
/// pide distinguir visualmente una notificacion "escalada" pero ninguna
/// regla real define ese criterio todavia - la columna existe para que
/// la UI ya soporte esa distincion cuando una regla real la produzca.
model NotificationReadModel {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  companyId            String    @map("company_id")
  branchId             String    @map("branch_id")
  recipientFirebaseUid String    @map("recipient_firebase_uid")
  notificationType     String    @map("notification_type")
  isEscalated          Boolean   @default(false) @map("is_escalated")
  title                String
  deepLink             String    @map("deep_link")
  readAt               DateTime? @map("read_at")
  sourceEventId        String    @unique @map("source_event_id")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@index([recipientFirebaseUid, readAt, createdAt])
  @@map("notifications_read_model")
}

model AuditEvent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  actorUserId    String?  @map("actor_user_id")
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  action         String
  changes        Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, entityType, entityId])
  @@map("audit_events")
}

/// TDD-KAIROS-TRANSVERSAL.md 7.4 - compromisos de vehiculo compartidos
/// entre Reserva y Alquiler (evita doble asignacion del mismo vehiculo)
model VehicleCommitment {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  vehicleId      String   @map("vehicle_id")
  sourceType     String   @map("source_type") // RESERVATION | RENTAL | MAINTENANCE
  sourceId       String   @map("source_id")
  status         String // ACTIVE | CONSOLIDATED | RELEASED | EXPIRED
  startsAt       DateTime @map("starts_at")
  endsAt         DateTime @map("ends_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([sourceType, sourceId])
  @@index([vehicleId, status])
  @@map("vehicle_commitments")
}

/// TR-02 (PANTALLAS-V2-B-TRANSVERSAL.md) - modelo minimo propuesto para
/// saber si un usuario esta en "primer acceso" (contrasena temporal, MFA
/// sin enrolar). PROPUESTO, no confirmado formalmente todavia por el
/// equipo - ver docs/decision-log.md. No modela roles/permisos (eso es
/// SDD-KAIROS-TRANSVERSAL.md 15.5, fuera de alcance de HU-21).
model UserProfile {
  id                     String    @id @default(uuid())
  organizationId         String    @map("organization_id")
  firebaseUid            String    @unique @map("firebase_uid")
  requiresPasswordChange Boolean   @default(true) @map("requires_password_change")
  mfaEnrolledAt          DateTime? @map("mfa_enrolled_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("user_profiles")
}

/// TR-05 (PANTALLAS-V2-B-TRANSVERSAL.md, HU-23) - maestros minimos de
/// empresa y sede (SDD-KAIROS-TRANSVERSAL.md 14.1/14.4: "empresa
/// propietaria" y "sede"). PROPUESTO - primera vez que estas entidades
/// se modelan en este backend; el detalle completo de organizacion
/// (empresa operadora, jerarquias, etc.) queda fuera de alcance de
/// HU-23, se amplia cuando otro modulo lo necesite.
model Company {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  branches     Branch[]
  assignments  UserCompanyAssignment[]
  reservations Reservation[]
  // Relaciones opuestas requeridas por Prisma para las FKs compuestas
  // (id, operatingCompanyId) -> Company(id, organizationId) agregadas en
  // Customer/Vehicle/Inquiry (hallazgo ALTO "referencias corregidas solo
  // a nivel organizacion, no empresa/sede", revision PR#6).
  customers    Customer[]
  vehicles     Vehicle[]
  inquiries    Inquiry[]
  rentals      Rental[]
  documentTemplates DocumentTemplate[]
  templates         Template[]
  returns      RentalReturn[]
  incidents    Incident[]
  matrixVersions RolePermissionMatrixVersion[]
  vacancies    Vacancy[]
  employees    Employee[]
  hrAreas      HrArea[]

  /// Hallazgo CRITICO de revision de seguimiento de PR#4 (revalidacion de
  /// 9e33c4f): sin esta clave compuesta, `organizationId` de una
  /// `UserCompanyAssignment` podia contradecir al de la `Company` que
  /// referencia (una asignacion de organization A podia apuntar a una
  /// empresa de organization B). Junto con la FK compuesta agregada abajo
  /// en `UserCompanyAssignment.company`, la base ya no permite guardar esa
  /// combinacion invalida - ver migracion
  /// 20260922000000_fix_company_organization_integrity.
  @@unique([id, organizationId])
  @@map("companies")
}

/// TR-05 - sede operativa de una empresa (SDD-KAIROS-TRANSVERSAL.md 14.1).
model Branch {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company      Company                 @relation(fields: [companyId], references: [id])
  assignments  UserCompanyAssignment[]
  reservations Reservation[]
  inquiries    Inquiry[]
  vehicles     Vehicle[]
  rentals      Rental[]
  returns      RentalReturn[]
  incidents    Incident[]
  matrixVersions RolePermissionMatrixVersion[]
  vacancies    Vacancy[]
  employees    Employee[]

  @@unique([id, companyId])
  @@index([companyId])
  @@map("branches")
}

/// TR-05 (BR-ORG-002) - asignaciones vigentes de un usuario a
/// empresa/sede. Es la unica fuente de verdad de "donde puede trabajar
/// hoy" un usuario - el usuario nunca envia un company_id/branch_id
/// libremente, solo elige entre lo que ya existe aqui
/// (SDD-KAIROS-TRANSVERSAL.md 14.3/14.4).
///
/// Hallazgo critico de revision PR#4 ("la base permite asociar una sede
/// con una empresa diferente"): `branch` ya NO es una FK simple por
/// `branchId` - es una FK COMPUESTA `(branchId, companyId)` hacia
/// `Branch(id, companyId)` (ver `@@unique([id, companyId])` en Branch).
/// Esto hace que insertar una asignacion donde `branchId` pertenezca a
/// una empresa distinta de `companyId` sea un error de integridad
/// referencial a nivel de base de datos, no solo una validacion de
/// aplicacion que se puede olvidar u omitir.
///
/// Hallazgo alto ("las asignaciones 'vigentes' no tienen vigencia"):
/// `active`/`validFrom`/`validUntil` modelan la vigencia real; antes la
/// existencia de la fila era el unico criterio (nunca expiraba ni se
/// podia revocar sin borrar el registro, perdiendo el historial).
///
/// PROVISIONAL (HU-24/TR-06): `role` es un modelo minimo para poder
/// enrutar al tablero correcto por rol. El modelo definitivo de roles y
/// permisos (matriz rol-accion-empresa-sede versionada) vive en ADM-02
/// (Roles y permisos, PANTALLAS-V2-B-SOPORTE.md), que todavia no esta
/// construido. Cuando exista, este campo se migra al modelo real de
/// ADM-02 - no se diseno como definitivo. El enum WorkerRole (7 valores,
/// 1:1 con los 7 prototipos aprobados de TR-06) vive justo antes de este
/// modelo.
enum WorkerRole {
  ADMINISTRACION
  AUDITORIA
  CAMPO
  FINANZAS
  FRONT_OFFICE
  GERENCIA
  PLATFORM_ADMIN
  RRHH
}

model UserCompanyAssignment {
  id             String     @id @default(uuid())
  organizationId String     @map("organization_id")
  firebaseUid    String     @map("firebase_uid")
  companyId      String     @map("company_id")
  branchId       String     @map("branch_id")
  /// DEPRECADA (roles dinamicos, fase 2): reemplazada por `roleId`. Nullable,
  /// nadie la lee ni la escribe; se retira en un PR posterior. El enum
  /// WorkerRole sigue vigente solo como catalogo de las `key` de los roles de
  /// sistema y para `dashboard_items.role`.
  role           WorkerRole?
  roleId         String     @map("role_id")
  active         Boolean    @default(true)
  validFrom      DateTime   @default(now()) @map("valid_from")
  validUntil     DateTime?  @map("valid_until")
  createdAt      DateTime   @default(now()) @map("created_at")

  /// Hallazgo CRITICO de revision de seguimiento de PR#4 (revalidacion de
  /// 9e33c4f): FK COMPUESTA `(companyId, organizationId)` hacia
  /// `Company(id, organizationId)` (ver `@@unique([id, organizationId])`
  /// en Company) - analoga a la FK compuesta de `branch` de abajo, mismo
  /// hallazgo pero para el nivel organization/company. Antes `company`
  /// era una FK simple por `companyId`, que no impedia guardar una
  /// asignacion cuyo `organizationId` no coincidiera con el
  /// `organizationId` real de esa empresa.
  company Company @relation(fields: [companyId, organizationId], references: [id, organizationId])
  branch  Branch  @relation(fields: [branchId, companyId], references: [id, companyId])
  /// FK compuesta (roleId, organizationId) -> Role(id, organizationId): el rol
  /// de la asignacion debe ser de la MISMA organizacion.
  roleRecord Role @relation(fields: [roleId, organizationId], references: [id, organizationId], map: "user_company_assignments_role_id_organization_id_fkey")

  @@unique([firebaseUid, companyId, branchId])
  @@index([firebaseUid])
  @@index([firebaseUid, active, validUntil])
  @@index([roleId, active], map: "user_company_assignments_role_id_active_idx")
  @@map("user_company_assignments")
}

/// PROVISIONAL (HU-27/RES, PROP-005 - ver docs/decision-log.md): modelo
/// minimo de Cliente, solo los campos que Reserva necesita leer/mostrar.
/// El modulo real de Clientes (Customers, ver SDD-RES-001 seccion 3.3)
/// no esta construido todavia. Se migra cuando exista.
model Customer {
  id                 String              @id @default(uuid())
  organizationId     String              @map("organization_id")
  /// Hallazgo ALTO de revision de seguimiento de PR#6 (d442508,
  /// "referencias corregidas solo a nivel organizacion, no
  /// empresa/sede"): sin este campo, un usuario autorizado en la sede A
  /// podia crear una reserva citando un cliente de la sede/empresa B
  /// dentro de la misma organizacion (Customer solo validaba
  /// organizationId). Se agrega el nivel de scope que SI esta respaldado
  /// por el resto de la arquitectura (BR-ORG-002: empresa es la unidad
  /// de tenancy real). El nivel de SEDE queda deliberadamente sin
  /// modelar aqui - no hay fuente BDD/SDD del modulo real de Clientes
  /// (todavia no construido) que diga si un cliente pertenece a una sede
  /// especifica o es compartido entre las sedes de una misma empresa;
  /// inventar esa regla violaria CLAUDE.md seccion 4. Se migra cuando el
  /// modulo real de Clientes exista.
  operatingCompanyId String              @map("operating_company_id")
  fullName           String              @map("full_name")
  documentType       String              @map("document_type")
  documentNumber     String              @map("document_number")
  /// CONFLICT-CON-002 (resuelto): la identidad del prospecto se persiste
  /// en Customer, no en Inquiry. Al registrar una consulta sin cliente
  /// formal, se crea primero el Customer con estos campos; el customerId
  /// resultante va en Inquiry.customer_id.
  nationality        InquiryNationality? @map("nationality")
  /// SC-CON-001.03: solo aplica a EXTRANJERO. CHECK en la migracion.
  countryEntryDate   DateTime?           @map("country_entry_date") @db.Date
  email              String?
  phone              String?
  address            String?
  /// Decision de diseno nueva (no existia un modulo/campo real de
  /// Clientes para esto): estado "rojo"/lista negra del cliente,
  /// introducido para BR-ALQ-013 (falta grave de ampliacion de
  /// alquiler). Semaforo de riesgo (BR-DEV-007/008, TD-DEV-002):
  /// NORMAL | AMBAR | ROJO. NORMAL equivale a SIN_OBSERVACION en los
  /// documentos. Solo avanza NORMAL -> AMBAR -> ROJO, nunca retrocede
  /// (helper de dominio modules/returns/domain/customer-risk-status.ts).
  /// Es String: no requiere migracion.
  status             String              @default("NORMAL")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at")

  operatingCompany Company       @relation(fields: [operatingCompanyId, organizationId], references: [id, organizationId])
  reservations     Reservation[]
  inquiries        Inquiry[]
  rentals          Rental[]
  rentalParties    RentalParty[]
  returns          RentalReturn[]

  @@unique([id, operatingCompanyId])
  @@unique([operatingCompanyId, documentType, documentNumber])
  @@index([operatingCompanyId])
  @@index([operatingCompanyId, documentNumber])
  @@index([fullName(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_customers_fullname_trgm")
  @@index([documentNumber(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_customers_docnumber_trgm")
  // LIMITE CONOCIDO: `idx_customers_email_trgm` (GIN gin_trgm_ops sobre email WHERE email IS NOT NULL,
  // migracion 20261011000001_search_trgm_indexes) es un indice PARCIAL; Prisma 5.22 no modela WHERE,
  // asi que vive solo en SQL. No lo borres ni lo recrees desde el schema.
  @@map("customers")
}

/// PROVISIONAL (HU-27/RES, PROP-005): modelo minimo de Vehiculo, solo los
/// campos que Reserva necesita leer/mostrar. El modulo real de Flota
/// (Fleet, ver SDD-RES-001 seccion 3.3) no esta construido todavia.
model Vehicle {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  operatingCompanyId String   @map("operating_company_id")
  branchId           String?  @map("branch_id")
  plate              String   @unique
  brand              String
  model              String
  year               Int?
  color              String?
  category           String?  @default("SEDAN")
  status             String   @default("AVAILABLE") // AVAILABLE | RENTED | MAINTENANCE | OUT_OF_SERVICE
  dailyRate          Decimal? @map("daily_rate") @db.Decimal(10, 2)
  depositMinimum     Decimal? @map("deposit_minimum") @db.Decimal(10, 2)
  /// Cantidad de pasajeros que admite el vehiculo (1..60). Tope de acompanantes de un alquiler (G-05, Fiorella 2026-10-16). NULL = sin tope.
  passengerCapacity  Int?     @map("passenger_capacity")
  /// Precio del combustible por unidad para este vehiculo (PEN). Insumo de la multa por combustible, que AUN NO se calcula (F-05).
  fuelPrice          Decimal? @map("fuel_price") @db.Decimal(10, 2)
  photoUrl           String?  @map("photo_url")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  operatingCompany Company       @relation(fields: [operatingCompanyId, organizationId], references: [id, organizationId])
  branch           Branch?       @relation(fields: [branchId, operatingCompanyId], references: [id, companyId], onDelete: Restrict)
  reservations     Reservation[]
  quotations       Quotation[]
  rentals          Rental[]
  returns          RentalReturn[]

  @@unique([id, operatingCompanyId])
  @@index([operatingCompanyId])
  @@index([operatingCompanyId, status])
  @@index([plate(ops: raw("gin_trgm_ops"))], type: Gin, map: "idx_vehicles_plate_trgm")
  @@map("vehicles")
}

/// TDD-CON-001.md DAT-CON-004 / BDD-CON-001.md 8.3 - canal de contacto
/// (enum informal "WhatsApp/llamada/presencial/web/redes"). Distinto de
/// `ChannelMode` (modalidad de exhibicion PRESENCIAL/VIRTUAL de Reserva).
enum InquiryChannel {
  WHATSAPP
  LLAMADA
  PRESENCIAL
  WEB
  REDES
}

/// TDD-CON-001.md seccion 8 - 4 estados del modelo fisico (seccion 9):
/// REGISTRADA -> COTIZADA -> CONVERTIDA | CERRADA_SIN_CONVERSION
/// (terminales, BR-CON-002: nunca ambos a la vez).
enum InquiryStatus {
  REGISTRADA
  COTIZADA
  CONVERTIDA
  CERRADA_SIN_CONVERSION
}

/// BDD-CON-001.md DAT-CON-002 (obligatoria, siempre) - determina el
/// tercer requisito documental (BR-CON-004).
enum InquiryNationality {
  PERUANO
  EXTRANJERO
}

/// Hallazgo CRITICO de revalidacion PR#7 (d7a6124, "migracion insegura
/// sobre datos existentes"): distingue las consultas capturadas por
/// CON-02 (`CON02`, snapshot completo obligatorio) de los stubs minimos
/// que PR#6 (PROP-005) creaba solo para respaldar la FK de Reserva
/// (`LEGACY_STUB`, backfilleados por la migracion
/// 20260923000000_inquiries_expand_backfill_contract sin inventar datos
/// que nunca se capturaron). Marcador EXPLICITO y documentado, mismo
/// criterio que el backfill 'FRONT_OFFICE' de WorkerRole (PR#5).
enum InquiryDataOrigin {
  CON02
  LEGACY_STUB
}

/// HU-26 (Consulta) - agregado `Inquiry` del modulo `Inquiries`
/// (TDD-CON-001.md secciones 7-9).
///
/// Hallazgo ALTO de revalidacion PR#7 ("brecha contractual con
/// CON-02"): ademas del DDL literal del TDD seccion 9, persiste el
/// snapshot de lo capturado en CON-02 (PANTALLAS-V3-B-CONSULTA.md punto
/// 6: canal, cliente -nombre, documento, nacionalidad-, uso, destino,
/// periodo, personas) para que CON-04 pueda reconstruir la consulta y la
/// trazabilidad UX-BDD-TDD quede cerrada (DAT-CON-001/002/003, BR-CON-004,
/// SC-CON-001.03 "fecha de ingreso al pais"). Las columnas del snapshot
/// son NULLABLE en la base solo para admitir los stubs `LEGACY_STUB`;
/// para `CON02` su obligatoriedad se exige con un CHECK
/// (`inquiries_con02_snapshot_check`, ver migracion) ademas de la
/// validacion de aplicacion - Prisma 5 no expone CHECK declarativos.
model Inquiry {
  id                     String              @id @default(uuid())
  organizationId         String              @map("organization_id")
  operatingCompanyId     String              @map("operating_company_id")
  branchId               String              @map("branch_id")
  customerId             String?             @map("customer_id")
  /// DAT-CON-004. NULL solo en `LEGACY_STUB` (sin fuente de la que
  /// derivarlo) - obligatorio para `CON02` via CHECK.
  channel                InquiryChannel?
  /// DAT-CON-001.
  touristUse             Boolean             @map("tourist_use")
  /// DAT-CON-003 - destino y tiempo estimado (condicionan el vehiculo
  /// elegible, BR-CON-005). CONFLICT-CON-002: la identidad del prospecto
  /// (nombre, documento, nacionalidad) se persiste en Customer. Inquiry
  /// conserva solo el contexto del viaje.
  destination            String?
  estimatedDays          Int?                @map("estimated_days")
  /// CON-02 "periodo" / "fecha" y "personas" (opcionales en el contrato).
  travelStartDate        DateTime?           @map("travel_start_date") @db.Date
  partySize              Int?                @map("party_size")
  dataOrigin             InquiryDataOrigin   @default(CON02) @map("data_origin")
  status                 InquiryStatus       @default(REGISTRADA)
  /// CHECK `inquiries_closed_reason_check` (TDD seccion 9).
  closedReason           String?             @map("closed_reason")
  createdAt              DateTime            @default(now()) @map("created_at")
  createdBy              String              @map("created_by")
  version                Int                 @default(1)

  /// FK COMPUESTA hacia Company(id, organizationId) - mismo patron que
  /// Reservation/UserCompanyAssignment (PR#4/PR#6).
  operatingCompany Company       @relation(fields: [operatingCompanyId, organizationId], references: [id, organizationId])
  /// FK COMPUESTA hacia Branch(id, companyId): la sede siempre pertenece
  /// a la misma empresa de la consulta.
  branch           Branch        @relation(fields: [branchId, operatingCompanyId], references: [id, companyId])
  /// FK simple (Prisma no admite una relacion opcional sobre una FK
  /// compuesta con una columna obligatoria). El aislamiento por empresa
  /// del cliente se exige en la aplicacion (RegisterInquiryHandler) - ver
  /// hallazgo ALTO "aislamiento de cliente y vehiculo".
  customer         Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  interactions     Interaction[]
  quotations       Quotation[]
  reservations     Reservation[]
  rentals          Rental[]

  @@unique([id, operatingCompanyId])
  @@index([operatingCompanyId])
  /// Hallazgo MEDIO de revalidacion PR#7 ("keyset real createdAt/id"):
  /// respalda el filtro de scope + orden (created_at DESC, id DESC) de la
  /// bandeja paginada.
  @@index([organizationId, operatingCompanyId, branchId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([organizationId, operatingCompanyId, branchId, status, createdAt(sort: Desc)])
  @@map("inquiries")
}

/// TDD-CON-001.md seccion 9 - registro append-only de cada contacto.
model Interaction {
  id         String         @id @default(uuid())
  inquiryId  String         @map("inquiry_id")
  channel    InquiryChannel
  occurredAt DateTime       @default(now()) @map("occurred_at")
  outcome    String?
  note       String?

  inquiry Inquiry @relation(fields: [inquiryId], references: [id])

  @@index([inquiryId])
  @@map("interactions")
}

/// TDD-CON-001.md seccion 9 - snapshot versionado del tarifario al cotizar.
/// `rateCardVersionId` almacena el marcador 'FLEET-DAILY-RATE' (constante
/// PRICE_SOURCE_MARKER en quote.handler.ts): el precio proviene de
/// Vehicle.dailyRate via FleetAvailabilityPort.checkEligibility() — no es
/// una FK a rate_card_versions (tabla eliminada en oct 2026, PROP-007-FINAL).
///
/// Hallazgo ALTO de revalidacion PR#7 ("aislamiento de cliente y
/// vehiculo incompleto"): `operatingCompanyId` se agrega para que
/// inquiry y vehicle sean FKs COMPUESTAS hacia (id, operatingCompanyId)
/// - a nivel de base de datos ya no es posible cotizar un vehiculo de
/// otra empresa (mismo patron que Reservation desde PR#6).
model Quotation {
  id                 String   @id @default(uuid())
  inquiryId          String   @map("inquiry_id")
  operatingCompanyId String   @map("operating_company_id")
  vehicleId          String   @map("vehicle_id")
  rateCardVersionId  String   @map("rate_card_version_id")
  destination        String
  estimatedDays      Int      @map("estimated_days")
  amount             Decimal  @db.Decimal(12, 2)
  currency           String   @db.Char(3)
  validUntil         DateTime @map("valid_until")
  createdAt          DateTime @default(now()) @map("created_at")

  inquiry Inquiry @relation(fields: [inquiryId, operatingCompanyId], references: [id, operatingCompanyId])
  vehicle Vehicle @relation(fields: [vehicleId, operatingCompanyId], references: [id, operatingCompanyId])

  @@index([inquiryId, createdAt(sort: Desc)])
  @@map("quotations")
}

/// TDD-RES-001.md seccion 8.1 - 5 estados reales (corregido 31 ago 2026:
/// sin PENDING_PAYMENT ni EXPIRED, no existe bloqueo provisional).
enum ReservationStatus {
  DRAFT
  CONFIRMED
  PENDING_SALE_RESOLUTION
  CONVERTED
  CANCELLED
}

/// TDD-RES-001.md seccion 7.2.
enum ChannelMode {
  PRESENCIAL
  VIRTUAL
}

/// TDD-RES-001.md seccion 9.2 - bloqueo atomico unico (BR-RES-009):
/// paymentValidatedAt y documentsCompletedAt deben estar AMBOS presentes
/// antes de que status pueda ser CONFIRMED (validado en aplicacion, ver
/// ConfirmReservationHandler). Hallazgo medio de revision PR#6
/// ("integridad solo en aplicacion"): Prisma 5 no expone CHECK
/// constraints declarativos en el schema, asi que se agregan a mano en
/// la migracion SQL (periodo start_at<end_at, version>=1, monto>0, y que
/// CONFIRMED exija payment/documents/confirmedAt) ademas de la
/// validacion de aplicacion existente - defensa en profundidad, no la
/// reemplaza.
///
/// Hallazgo critico "IDOR entre sedes/empresas": `branch` ahora es una FK
/// COMPUESTA `(branchId, operatingCompanyId)` hacia `Branch(id,
/// companyId)` (mismo patron que UserCompanyAssignment desde PR#4) - a
/// nivel de base de datos ya no es posible insertar una reserva cuya
/// sede pertenezca a una empresa distinta de `operatingCompanyId`.
model Reservation {
  id                    String            @id @default(uuid())
  organizationId        String            @map("organization_id")
  operatingCompanyId    String            @map("operating_company_id")
  branchId              String            @map("branch_id")
  /// CONFLICT-CON-001 (resuelto): `POST /reservations` crea una reserva
  /// directamente (sin consulta previa); la unica via para crear una
  /// reserva DESDE una consulta sigue siendo `convert-to-reservation`.
  /// inquiryId es nullable para el caso de creacion directa; el UNIQUE
  /// garantiza que una consulta se convierte a lo sumo una vez (NULLs son
  /// distintos entre si en PostgreSQL UNIQUE).
  inquiryId             String?           @unique @map("inquiry_id")
  customerId            String            @map("customer_id")
  vehicleId             String            @map("vehicle_id")
  status                ReservationStatus @default(DRAFT)
  channelMode           ChannelMode       @map("channel_mode")
  startAt               DateTime          @map("start_at")
  endAt                 DateTime          @map("end_at")
  /// BR-RES-001 - parametro versionado; PROVISIONAL: valor vigente fijo
  /// en codigo (S/300, version 1) - ver docs/decision-log.md PROP-005.
  /// Se migra a una tabla de parametros versionada real cuando exista.
  requiredPaymentAmount Decimal           @map("required_payment_amount") @db.Decimal(12, 2)
  currency              String            @db.Char(3)
  paymentPolicyVersion  Int               @map("payment_policy_version")
  paymentValidatedAt    DateTime?         @map("payment_validated_at")
  documentsCompletedAt  DateTime?         @map("documents_completed_at")
  confirmedAt           DateTime?         @map("confirmed_at")
  createdAt             DateTime          @default(now()) @map("created_at")
  createdBy             String            @map("created_by")
  version               Int               @default(1)

  /// Hallazgo ALTO de revision de seguimiento de PR#6 (d442508,
  /// "referencias corregidas solo a nivel organizacion, no
  /// empresa/sede"): inquiry/customer/vehicle ahora son FK COMPUESTAS
  /// hacia (id, operatingCompanyId) de cada entidad - a nivel de base de
  /// datos ya no es posible insertar una reserva cuyo cliente, vehiculo
  /// o consulta de origen pertenezca a una empresa distinta de
  /// `operatingCompanyId`, cerrando el cruce cross-company que antes solo
  /// se evitaba (a medias) en la aplicacion.
  ///
  /// `operatingCompany` tambien pasa de FK simple a FK COMPUESTA
  /// `(operatingCompanyId, organizationId) -> Company(id, organizationId)`
  /// - mismo patron y mismo motivo que la FK compuesta agregada en PR#4
  /// para UserCompanyAssignment.company (evita que organizationId
  /// contradiga a la empresa referenciada).
  /// FK simple (inquiryId nullable): Prisma no admite relacion opcional
  /// sobre FK compuesta cuando uno de los campos es NOT NULL. El aislamiento
  /// empresa<>consulta se valida en el handler (cuando inquiryId presente).
  inquiry          Inquiry?  @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  customer         Customer @relation(fields: [customerId, operatingCompanyId], references: [id, operatingCompanyId])
  vehicle          Vehicle  @relation(fields: [vehicleId, operatingCompanyId], references: [id, operatingCompanyId])
  operatingCompany Company  @relation(fields: [operatingCompanyId, organizationId], references: [id, organizationId])
  branch           Branch   @relation(fields: [branchId, operatingCompanyId], references: [id, companyId])

  acceptance  ReservationAcceptance?
  rental      Rental?
  documents   ReservationDocument[]
  resolutions ReservationResolution[]

  // Hallazgo critico PR#6 ("IDOR entre sedes/empresas"): este indice
  // respalda el filtro de scope completo (organizationId +
  // operatingCompanyId + branchId) que ahora usan findById/list/las
  // mutaciones - antes solo existia el indice por operatingCompanyId.
  @@index([organizationId, operatingCompanyId, branchId, status, createdAt])
  @@index([customerId, createdAt])
  @@map("reservations")
}

/// TDD-RES-001.md seccion 9.3 - evidencia de aceptacion remota (BR-RES-006).
/// PROVISIONAL: evidenceRef reemplaza al FK real a evidence(id) del TDD
/// (el modulo Evidence no esta construido) - guarda una referencia de
/// texto libre (p.ej. URL de almacenamiento) sin validar su existencia.
model ReservationAcceptance {
  id                   String    @id @default(uuid())
  reservationId        String    @unique @map("reservation_id")
  evidenceRef          String    @map("evidence_ref")
  termsVersion         String    @map("terms_version")
  acceptedByCustomerId String    @map("accepted_by_customer_id")
  acceptedAt           DateTime? @map("accepted_at")
  recordedBy           String    @map("recorded_by")

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@map("reservation_acceptances")
}

/// TDD-RES-001.md seccion 9.3 / UC-RES-004 (BR-RES-007, RES-06/RES-07) -
/// resolucion ante la venta de un vehiculo reservado. Una fila por evento
/// de venta: nace al registrar la venta (flag-sale, customer_decision NULL =
/// pendiente) y se cierra con resolve-sale. DESVIACION respecto al DDL del
/// TDD (customer_decision NOT NULL, refund_id FK a payments): no existe
/// modulo Payments, asi que la decision es nullable mientras esta pendiente
/// y el reembolso se modela como `refund_status` (PENDING_TRANSFER = Gerencia
/// debe transferir), sin integracion de pagos - ver DEC-RES-SALE-001.
/// El indice unico parcial (una resolucion abierta por reserva) y los CHECK
/// viven solo en SQL (Prisma 5 no los declara).
model ReservationResolution {
  id                   String    @id @default(uuid())
  organizationId       String    @map("organization_id")
  reservationId        String    @map("reservation_id")
  reason               String    @default("VEHICLE_SOLD") @db.VarChar(30)
  originalVehicleId    String    @map("original_vehicle_id")
  offeredVehicleId     String?   @map("offered_vehicle_id")
  offerNote            String?   @map("offer_note")
  flaggedBy            String    @map("flagged_by")
  flaggedAt            DateTime  @default(now()) @map("flagged_at")
  /// NULL = pendiente de decision del cliente; 'ACCEPTED' | 'REJECTED'.
  customerDecision     String?   @map("customer_decision") @db.VarChar(20)
  alternativeVehicleId String?   @map("alternative_vehicle_id")
  /// 'PENDING_TRANSFER' cuando el cliente rechazo (Gerencia transfiere la devolucion).
  refundStatus         String?   @map("refund_status") @db.VarChar(30)
  resolutionNote       String?   @map("resolution_note")
  resolvedBy           String?   @map("resolved_by")
  resolvedAt           DateTime? @map("resolved_at")

  reservation Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId, flaggedAt], map: "reservation_resolutions_reservation_idx")
  @@map("reservation_resolutions")
}

/// TR-06 (SDD-KAIROS-TRANSVERSAL.md 18.2, HU-24) - proyeccion de lectura
/// del Tablero por rol, construida a partir de outbox_events (TDD-
/// KAIROS-TRANSVERSAL.md 7.3, ADR-KAI-003). No reemplaza outbox_events ni
/// las tablas de dominio de cada modulo - es una tabla de lectura propia
/// de UI, alimentada por un proyector (ver DashboardEventProjectorService,
/// modulo dashboard-projections) que consume eventos ya publicados
/// (ReservationCreated/Confirmed/Cancelled hoy; se agregan mas fuentes
/// cuando Rentals/Returns/Recruitment/HR-Administration existan).
///
/// Se ancla a organizationId/operatingCompanyId/branchId/role en vez de a
/// un userId especifico: el modelo de autorizacion actual
/// (WorkContextAuthorizationService) resuelve rol + empresa/sede, no
/// "asignado a mi" - los 7 roles comparten tablero por sede
/// (GetDashboardHandler ya funciona asi desde HU-24). Cuando exista
/// asignacion individual real (ADM-02), se agrega un userId opcional sin
/// romper este modelo.
///
/// PROVISIONAL, igual que DashboardResponse en el OpenAPI: `itemType`,
/// `priority` y `deepLink` siguen el diseno de
/// claude/Diseno_Agregador_Transversal_TR-06-07-08.md (Project KAIROS),
/// pendiente de contraste formal cuando el resto de fuentes (Rentals,
/// Returns, etc.) existan.
model DashboardItem {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  operatingCompanyId String    @map("operating_company_id")
  branchId           String    @map("branch_id")
  role               WorkerRole
  itemType           String    @map("item_type") // 'TASK' | 'ALERT' | 'DRAFT' | 'ACTIVITY'
  priority           Int       @default(0)
  title              String
  detail             String?
  deepLink           String    @map("deep_link")
  sourceType         String    @map("source_type") // 'RESERVATION' | 'RENTAL' | 'RETURN' | 'INQUIRY' | 'RECRUITMENT' | 'HR'
  sourceId           String    @map("source_id")
  sourceEventId      String    @map("source_event_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  expiresAt          DateTime? @map("expires_at")
  dismissedAt        DateTime? @map("dismissed_at")

  @@unique([sourceEventId, itemType])
  @@index([organizationId, operatingCompanyId, branchId, role, dismissedAt, priority])
  @@index([sourceType, dismissedAt], map: "idx_dashboard_items_source_active")
  @@index([dismissedAt], map: "dashboard_items_dismissed_at_idx")
  @@map("dashboard_items")
}

/// TDD-03-alquiler seccion 8.1 - 10 estados del ciclo de vida de Alquiler.
enum RentalStatus {
  DRAFT
  VALIDATION
  NOTARY_EVALUATION
  CONTRACTING
  PENDING_DELIVERY
  ACTIVE
  EXTENSION_PENDING
  RETURN_IN_PROGRESS
  CLOSED
  CANCELLED
}

/// TDD-03-alquiler seccion 7.2 / BR-ALQ-005 - resultado de prueba de alcolimetro.
enum AlcoholTestResult {
  FAVORABLE
  DESFAVORABLE
  RECHAZADO
}

/// TDD-03-alquiler seccion 7.2 / BR-ALQ-003/004 - resultado de evaluacion notarial.
enum NotaryResult {
  MANDATORY
  DOUBLE_DEPOSIT
  THIRD_PATH_ELIGIBLE
  MANUAL_REVIEW
}

/// TDD-03-alquiler seccion 9.2 - Agregado principal de Alquiler (ALQ-01..11).
model Rental {
  id                 String             @id @default(uuid())
  organizationId     String             @map("organization_id")
  operatingCompanyId String             @map("operating_company_id")
  branchId           String             @map("branch_id")
  inquiryId          String?            @map("inquiry_id")
  reservationId      String?            @unique @map("reservation_id")
  customerId         String             @map("customer_id")
  vehicleId          String             @map("vehicle_id")
  planCode           String             @default("NORMAL") @map("plan_code") // NORMAL | PLUS | LIBRE
  status             RentalStatus       @default(DRAFT)
  startAt            DateTime?          @map("start_at")
  expectedEndAt      DateTime?          @map("expected_end_at")
  alcoholTestResult  AlcoholTestResult? @map("alcohol_test_result")
  createdAt          DateTime           @default(now()) @map("created_at")
  createdBy          String             @map("created_by")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")
  updatedBy          String             @map("updated_by")
  version            Int                @default(1)
  /// DEC-ALQ-DRIVERRATE-001: tarifa diaria manual del conductor de la empresa (NULL = sin valor manual; CHECK >= 0 en la migracion).
  companyDriverDailyRate Decimal?   @db.Decimal(10, 2) @map("company_driver_daily_rate")

  operatingCompany Company      @relation(fields: [operatingCompanyId, organizationId], references: [id, organizationId])
  branch           Branch       @relation(fields: [branchId, operatingCompanyId], references: [id, companyId])
  customer         Customer     @relation(fields: [customerId, operatingCompanyId], references: [id, operatingCompanyId])
  vehicle          Vehicle      @relation(fields: [vehicleId, operatingCompanyId], references: [id, operatingCompanyId])
  reservation      Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  inquiry          Inquiry?     @relation(fields: [inquiryId], references: [id], onDelete: SetNull)

  parties          RentalParty[]
  notaryEvaluation NotaryEvaluation?
  contract         RentalContract?
  deposit          RentalDeposit?
  extensions       RentalExtension[]
  evidence         RentalEvidence[]
  documents        RentalDocument[]
  rentalReturn     RentalReturn?
  incidents        Incident[]

  @@unique([id, operatingCompanyId])
  @@index([operatingCompanyId, status, createdAt(sort: Desc)])
  @@index([organizationId, operatingCompanyId, branchId, status, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@map("rentals")
}

/// ALQ-09 / BR-INS-003 / BR-INS-004 - evidencia real (foto/video) del
/// checklist de entrega de un alquiler. No existe aun una tabla
/// transversal `evidence` (TDD-RES-001 seccion 9.3 ya documenta el mismo
/// gap con `ReservationAcceptance.evidenceRef` como placeholder) - este
/// modelo es especifico de Rentals, analogo al patron ya usado por Fleet
/// (GcsVehiclePhotoService) pero persistiendo un registro por archivo en
/// vez de un solo campo `photoUrl`, porque aqui se deben contar/validar
/// multiples evidencias (35 fotos + 3 videos) antes de permitir
/// complete-delivery.
model RentalEvidence {
  id                 String             @id @default(uuid())
  organizationId     String             @map("organization_id")
  operatingCompanyId String             @map("operating_company_id")
  rentalId           String             @map("rental_id")
  type               RentalEvidenceType
  zone               String
  objectUrl          String             @map("object_url")
  uploadedBy         String             @map("uploaded_by")
  uploadedAt         DateTime           @default(now()) @map("uploaded_at")

  rental Rental @relation(fields: [rentalId, operatingCompanyId], references: [id, operatingCompanyId])

  @@index([rentalId, type])
  @@index([organizationId, operatingCompanyId, rentalId], map: "rental_evidence_organization_id_operating_company_id_renta_idx")
  @@map("rental_evidence")
}

enum RentalEvidenceType {
  PHOTO
  VIDEO
}

/// TDD-03-alquiler seccion 9.2 / BR-ALQ-015 - intervinientes del alquiler.
model RentalParty {
  id         String   @id @default(uuid())
  rentalId   String   @map("rental_id")
  customerId String   @map("customer_id")
  role       String   // 'SIGNER' | 'DRIVER' | 'RESPONSIBLE'
  /// DEC-ALQ-OWN-DRIVER-005: DRIVER de persona juridica -> referencia de la adenda firmada (conductor autorizado).
  addendumDocumentRef String? @map("addendum_document_ref") @db.VarChar(200)
  createdAt  DateTime @default(now()) @map("created_at")

  rental   Rental   @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([rentalId])
  @@map("rental_parties")
}

/// TDD-03-alquiler seccion 9.3 / BR-ALQ-003/004 - evaluacion notarial.
model NotaryEvaluation {
  id            String       @id @default(uuid())
  rentalId      String       @unique @map("rental_id")
  policyVersion Int          @map("policy_version")
  result        NotaryResult
  reason        String       @db.VarChar(500)
  evaluatedAt   DateTime     @default(now()) @map("evaluated_at")
  approvedBy    String?      @map("approved_by")
  justification String?      @db.VarChar(500)

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@map("notary_evaluations")
}

/// TDD-03-alquiler seccion 9.3 / BR-DOC-002/003 - contrato inmutable formalizado.
/// TPL-TODO-001+002: templateVersionId eliminado (migración 20261009000002); templateId → templates.id.
model RentalContract {
  id            String    @id @default(uuid())
  rentalId      String    @unique @map("rental_id")
  templateId    String?   @map("template_id") @db.Uuid
  documentRef   String    @map("document_ref")
  status        String    @default("PENDING") // PENDING | SIGNED | VOID
  signedAt      DateTime? @map("signed_at")
  signatureData String?   @map("signature_data") @db.Text
  /// BR-DOC-003: combinacion (titular natural/juridica x con/sin conductor)
  /// con la que se eligio la plantilla. NULL = contratos anteriores a la seleccion.
  contractVariant String? @map("contract_variant") @db.VarChar(40)
  /// DEC-ALQ-COMPANY-DRIVER-004: false cuando el cliente pidio conductor de la empresa (no hay garantia ni fila
  /// en rental_deposits). Default true = contratos anteriores / con garantia.
  depositRequired Boolean @default(true) @map("deposit_required")
  /// DEC-ALQ-COMPANY-DRIVER-004: credito de reserva sin garantia a la cual aplicarse (saldo a favor, sin reembolso
  /// automatico). Si hay garantia el excedente vive en rental_deposits.reservation_credit_excess.
  reservationCreditExcess Decimal @default(0) @map("reservation_credit_excess") @db.Decimal(12, 2)
  createdAt     DateTime  @default(now()) @map("created_at")

  rental      Rental    @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  templateNew Template? @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@map("rental_contracts")
}

/// Bug-07 / ALQ-06 - documentos adjuntos del cliente en la etapa de validaciones.
/// Se suben a GCS y se registra la URL. Tipos: LICENSE | ID_DOCUMENT | PROOF_OF_ADDRESS | BANK_STATEMENT | OTHER.
model RentalDocument {
  id           String   @id @default(uuid())
  rentalId     String   @map("rental_id")
  documentType String   @map("document_type") @db.VarChar(40)
  objectUrl    String   @map("object_url")
  createdAt    DateTime @default(now()) @map("created_at")

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([rentalId])
  @@map("rental_documents")
}

/// Bug-03 - comprobante de pago adjunto a una reserva.
/// Se sube a GCS y se registra la URL. Types: PAYMENT_VOUCHER | OTHER.
model ReservationDocument {
  id            String   @id @default(uuid())
  reservationId String   @map("reservation_id")
  documentType  String   @map("document_type") @db.VarChar(40)
  objectUrl     String   @map("object_url")
  createdAt     DateTime @default(now()) @map("created_at")

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([reservationId])
  @@map("reservation_documents")
}


/// TDD-KAIROS-MVP-002-TPL §4.1 - plantillas de documentos base standalone.
/// Consolida RENTAL_CONTRACT (antes ContractTemplate en rentals) y RETURN_RESPONSIBILITY
/// (antes DocumentTemplate en document-templates) en un módulo propio.
/// Invariante única ACTIVE por (company_id, type): índice parcial "templates_unique_active"
/// en migración 20261009000000_add_templates — Prisma no soporta WHERE en @@unique.
model Template {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @map("organization_id")
  companyId      String    @map("company_id")
  type           String    @db.VarChar(50)
  name           String    @db.VarChar(200)
  version        Int?
  status         String    @default("DRAFT") // DRAFT | ACTIVE | RETIRED
  documentUrl    String?   @map("document_url")
  documentFormat String?   @map("document_format") // PDF | DOCX
  effectiveFrom  DateTime? @map("effective_from") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy      String    @map("created_by")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy      String    @map("updated_by")

  company         Company          @relation(fields: [companyId, organizationId], references: [id, organizationId], onDelete: Restrict, onUpdate: Cascade)
  rentalContracts RentalContract[]

  @@index([companyId, type], map: "templates_company_type_idx")
  @@index([organizationId], map: "templates_organization_idx")
  @@map("templates")
}

/// TDD-03-alquiler seccion 9.4 - garantia retenida para el alquiler.
/// Migration 20261011000002: closed_at + closure_notes anadidos para PAG-01/PAG-02 (TDD-PAG-001).
model RentalDeposit {
  id             String                    @id @default(uuid())
  rentalId       String                    @unique @map("rental_id")
  originalAmount Decimal                   @map("original_amount") @db.Decimal(12, 2)
  currency       String                    @db.Char(3)
  status         String                    @default("HELD") // HELD | RETURNED | RETAINED | PARTIALLY_RETAINED
  closedAt       DateTime?                 @map("closed_at") @db.Timestamptz(6)
  closureNotes   String?                   @map("closure_notes") @db.VarChar(500)
  /// P0-03 opcion (a): parte de `originalAmount` (garantia TOTAL) que ya
  /// estaba pagada como monto de la reserva y se traslada integra a la
  /// garantia. Solo alquileres de origen Reserva (0 en alquiler directo).
  /// Monto a cobrar al formalizar = originalAmount - reservationCreditAmount.
  reservationCreditAmount Decimal          @default(0) @map("reservation_credit_amount") @db.Decimal(12, 2)
  /// DEC-ALQ-RESCREDIT-002: excedente del monto de la reserva sobre la garantia
  /// (saldo a favor visible; sin reembolso ni calculo automatico, pregunta a Finanzas).
  reservationCreditExcess Decimal          @default(0) @map("reservation_credit_excess") @db.Decimal(12, 2)
  createdAt      DateTime                  @default(now()) @map("created_at")

  rental      Rental                    @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  adjustments RentalDepositAdjustment[]

  @@map("rental_deposits")
}

/// TDD-03-alquiler seccion 9.4 - ajustes append-only sobre la garantia.
model RentalDepositAdjustment {
  id           String        @id @default(uuid())
  depositId    String        @map("deposit_id")
  type         String        // 'DISCOUNT' | 'FULL_RETENTION' | 'RELEASE' | 'IMMOBILIZATION_CHARGE'
  amount       Decimal       @db.Decimal(12, 2)
  reason       String        @db.VarChar(500)
  authorizedBy String        @map("authorized_by")
  createdAt    DateTime      @default(now()) @map("created_at")

  deposit RentalDeposit @relation(fields: [depositId], references: [id], onDelete: Cascade)

  @@index([depositId])
  @@map("rental_deposit_adjustments")
}

/// TDD-03-alquiler seccion 9.4 / BR-ALQ-012/013 - solicitudes de ampliacion.
model RentalExtension {
  id                  String    @id @default(uuid())
  rentalId            String    @map("rental_id")
  requestedEndAt      DateTime  @map("requested_end_at")
  status              String    @default("PENDING") // PENDING | AUTHORIZED | REJECTED | BREACH
  paymentId           String?   @map("payment_id")
  addendumDocumentRef String?   @map("addendum_document_ref")
  requestedAt         DateTime  @default(now()) @map("requested_at")
  resolvedAt          DateTime? @map("resolved_at")

  rental Rental @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([rentalId])
  @@map("rental_extensions")
}

/// TDD-04-devolucion seccion 8.1 - 8 estados del ciclo de vida de Devolución.
enum ReturnStatus {
  PROGRAMADA
  RECEPCION_PROVISIONAL
  INSPECCION
  SIN_DANOS
  CON_DANOS
  CIERRE_FINANCIERO
  CERRADA
  CANCELADA
}

/// TDD-04-devolucion seccion 7.2 - Custodia fisica preventiva del vehiculo.
enum CustodyHolder {
  CLIENTE
  VELOXRENT
  TALLER
}

/// TDD-04-devolucion seccion 7.2 / BR-DEV-006 - Origen del daño.
enum DamageOrigin {
  AESTHETIC
  TECHNICAL
}

/// TDD-04-devolucion seccion 7.2 / BR-DEV-007 - Severidad del daño.
enum DamageSeverity {
  LEVE
  MODERADO
  GRAVE
}

/// TDD-04-devolucion seccion 7.2 / BDD-04-devolucion - Nivel de combustible.
enum ReturnFuelLevel {
  EMPTY
  ONE_QUARTER
  HALF
  THREE_QUARTERS
  FULL
}

/// PROP-014 (PROVISIONAL) - Decision de Gerencia ante alcolimetro de salida desfavorable.
enum AlcoholEscalationDecision {
  CONTINUE_TO_INSPECTION
  KEEP_IN_CUSTODY
}

/// TDD-04-devolucion seccion 9.5 / TR-08 - Tipo de evidencia de retorno.
enum ReturnEvidenceType {
  PHOTO
  VIDEO
}

/// TDD-04-devolucion seccion 7.1 / 9.2 - Agregado principal de Devolución (DEV-01..10).
model RentalReturn {
  id                    String             @id @default(uuid())
  organizationId        String             @map("organization_id")
  operatingCompanyId    String             @map("operating_company_id")
  branchId              String             @map("branch_id")
  rentalId              String             @unique @map("rental_id")
  vehicleId             String             @map("vehicle_id")
  customerId            String             @map("customer_id")
  status                ReturnStatus       @default(PROGRAMADA)
  custodyHolder         CustodyHolder      @default(CLIENTE) @map("custody_holder")
  customerPresent       Boolean            @default(true) @map("customer_present")
  mileageAtReturn       Int?               @map("mileage_at_return")
  fuelLevelAtReturn     ReturnFuelLevel?   @map("fuel_level_at_return")
  alcoholTestResult     AlcoholTestResult? @map("alcohol_test_result")
  alcoholTestNotes      String?            @map("alcohol_test_notes")
  /// PROP-014 (PROVISIONAL): resolucion de Gerencia ante alcolimetro desfavorable/rechazado. La ultima decision
  /// queda en la fila; cada decision se audita (RETURN_ALCOHOL_ESCALATION_RESOLVED).
  alcoholEscalationDecision    AlcoholEscalationDecision? @map("alcohol_escalation_decision")
  alcoholEscalationMarkedRed   Boolean?                   @map("alcohol_escalation_marked_red")
  alcoholEscalationNotes       String?                    @map("alcohol_escalation_notes")
  alcoholEscalationDecidedById String?                    @map("alcohol_escalation_decided_by_id")
  alcoholEscalationDecidedAt   DateTime?                  @map("alcohol_escalation_decided_at")
  /// BR-DEV-009 / DAT-DEV-005 / EX-DEV-001: documento de responsabilidad firmado al completar la inspeccion.
  /// PROVISIONAL: validez juridica pendiente de Legal (mismo criterio que PROP-012). signatureData no se expone en API.
  responsibilitySignerName     String?                    @map("responsibility_signer_name")
  responsibilitySignerIsHolder Boolean?                   @map("responsibility_signer_is_holder")
  responsibilitySignerRelation String?                    @map("responsibility_signer_relation")
  responsibilitySignatureData  String?                    @map("responsibility_signature_data")
  responsibilitySignedAt       DateTime?                  @map("responsibility_signed_at")
  /// DEC-DEV-LATE-CHARGE-002 (Fiorella 2026-10-16): cargo por retraso MANUAL (monto digitado por usuario autorizado,
  /// sin calculo automatico). El ultimo registro queda en la fila; cada registro se audita (RETURN_LATE_CHARGE_REGISTERED).
  lateChargeAmount         Decimal?           @map("late_charge_amount") @db.Decimal(12, 2)
  lateChargeNotes          String?            @map("late_charge_notes")
  lateChargeRegisteredById String?            @map("late_charge_registered_by_id")
  lateChargeRegisteredAt   DateTime?          @map("late_charge_registered_at")
  scheduledAt           DateTime           @map("scheduled_at")
  receivedAt            DateTime?          @map("received_at")
  inspectedAt           DateTime?          @map("inspected_at")
  closedAt              DateTime?          @map("closed_at")
  finalSettlementAmount Decimal?           @map("final_settlement_amount") @db.Decimal(12, 2)
  notes                 String?
  createdAt             DateTime           @default(now()) @map("created_at")
  createdBy             String             @map("created_by")
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at")
  updatedBy             String             @map("updated_by")
  version               Int                @default(1)

  operatingCompany Company  @relation(fields: [operatingCompanyId, organizationId], references: [id, organizationId])
  branch           Branch   @relation(fields: [branchId, operatingCompanyId], references: [id, companyId])
  rental           Rental   @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  vehicle          Vehicle  @relation(fields: [vehicleId, operatingCompanyId], references: [id, operatingCompanyId])
  customer         Customer @relation(fields: [customerId, operatingCompanyId], references: [id, operatingCompanyId])

  damages               ReturnDamage[]
  immobilizationCharges ImmobilizationCharge[]
  evidences             ReturnEvidence[]
  incidents             Incident[]
  reminder              ReturnReminder?

  @@unique([id, operatingCompanyId])
  @@index([operatingCompanyId, status, createdAt(sort: Desc)])
  @@index([organizationId, operatingCompanyId, branchId, status, createdAt(sort: Desc)])
  @@index([rentalId])
  @@map("returns")
}

/// BR-DEV-004 / DAT-DEV-001 / DEC-DEV-REMINDER-001 - Estado del recordatorio previo de devolución. El envío por
/// WhatsApp es MANUAL-ASISTIDO: el sistema genera el texto (PENDING) y el operador registra SENT | FAILED.
enum ReturnReminderStatus {
  PENDING
  SENT
  FAILED
}

/// BR-DEV-004 - Recordatorio 3 h antes de la hora pactada (uno por devolución). Lo genera el scheduler
/// (ReturnReminderScheduler); `return_id` UNIQUE hace idempotente la generación entre réplicas.
model ReturnReminder {
  id                 String               @id @default(uuid())
  organizationId     String               @map("organization_id")
  operatingCompanyId String               @map("operating_company_id")
  branchId           String               @map("branch_id")
  returnId           String               @unique @map("return_id")
  status             ReturnReminderStatus @default(PENDING)
  /// scheduledAt - 3 h.
  dueAt              DateTime             @map("due_at")
  messageText        String               @map("message_text")
  generatedAt        DateTime             @default(now()) @map("generated_at")
  sentAt             DateTime?            @map("sent_at")
  sentBy             String?              @map("sent_by")
  resultNote         String?              @map("result_note")
  /// Cantidad de registros de resultado (ENVIADO/FALLIDO) del operador.
  attempts           Int                  @default(0)
  version            Int                  @default(1)
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at")

  rentalReturn RentalReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([organizationId, operatingCompanyId, branchId, status, dueAt], map: "idx_return_reminders_scope_status_due")
  @@map("return_reminders")
}

/// TDD-04-devolucion seccion 9.2 - Daño detectado en devolución (estético o técnico).
model ReturnDamage {
  id                      String         @id @default(uuid())
  returnId                String         @map("return_id")
  origin                  DamageOrigin
  severity                DamageSeverity
  damagedZone             String?        @map("damaged_zone")
  estimatedAmount         Decimal?       @map("estimated_amount") @db.Decimal(12, 2)
  externalReportReference String?        @map("external_report_reference")
  description             String?
  createdAt               DateTime       @default(now()) @map("created_at")

  rentalReturn          RentalReturn           @relation(fields: [returnId], references: [id], onDelete: Cascade)
  immobilizationCharges ImmobilizationCharge[]

  @@index([returnId])
  @@map("return_damages")
}

/// TDD-04-devolucion seccion 9.3 / BR-DEV-011 - Cargo por paralización en taller.
model ImmobilizationCharge {
  id          String   @id @default(uuid())
  returnId    String   @map("return_id")
  damageId    String?  @map("damage_id")
  daysCharged Int      @map("days_charged")
  dailyRate   Decimal  @map("daily_rate") @db.Decimal(12, 2)
  totalAmount Decimal  @map("total_amount") @db.Decimal(12, 2)
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  rentalReturn RentalReturn  @relation(fields: [returnId], references: [id], onDelete: Cascade)
  damage       ReturnDamage? @relation(fields: [damageId], references: [id], onDelete: SetNull)

  @@index([returnId])
  @@map("immobilization_charges")
}

/// TDD-04-devolucion seccion 9.5 / TR-08 - Evidencia fotográfica y video de devolución.
model ReturnEvidence {
  id                 String             @id @default(uuid())
  organizationId     String             @map("organization_id")
  operatingCompanyId String             @map("operating_company_id")
  returnId           String             @map("return_id")
  type               ReturnEvidenceType
  zone               String
  objectUrl          String             @map("object_url")
  uploadedBy         String             @map("uploaded_by")
  uploadedAt         DateTime           @default(now()) @map("uploaded_at")

  rentalReturn RentalReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId, type])
  @@index([organizationId, operatingCompanyId, returnId])
  @@map("return_evidence")
}

/// INC-01/INC-02 (PANTALLAS-V2-B-SOPORTE.md) - tipo de incidencia. Catalogo minimo, ampliable.
enum IncidentType {
  KEY_LOSS
  CRASH_OR_DAMAGE
  TRAFFIC_FINE_OR_INTERVENTION
  TOWING
  OTHER
  /// DEC-ALQ-UNAUTH-DRIVER-003: otra persona conduce sin estar autorizada; decide Gerencia caso por caso.
  UNAUTHORIZED_DRIVER
}


/// PROP-015b — Plantillas de documentos para firma del cliente (BR-DEV-009).
/// Una versión activa por combinación companyId + type.
model DocumentTemplate {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  type      String   @db.VarChar(50)
  name      String   @db.VarChar(200)
  content   String
  version   Int
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, type, version])
  @@index([companyId, type, isActive])
  @@map("document_templates")
}

/// Severidad de la incidencia (decision de producto: LEVE/MODERADA/GRAVE; el TDD usa MODERADO para danos de Devolucion).
enum IncidentSeverity {
  LEVE
  MODERADA
  GRAVE
}

/// SDD 11.1: Abierta -> Cerrada / Via legal. Solo ABIERTA bloquea la liberacion de garantia (DEV-09, NFR-KAI-008).
enum IncidentStatus {
  ABIERTA
  CERRADA
  VIA_LEGAL
}

/// Tipo de entrada del historial append-only (INC-02).
enum IncidentActionKind {
  REPORTED
  ACTION
  RESOLVED
  CLOSED
  REFERRED_LEGAL
}

/// SDD-DEV-001 11.1 / diccionario de datos 1.8 (RIO) - Incidencia ligada a un Alquiler y, opcionalmente, a una Devolucion.
/// FK compuestas (id, operating_company_id) hacia Rental/RentalReturn: la base impide ligar una incidencia a un expediente de otra empresa.
/// responsibleUserId/createdBy/updatedBy guardan el firebaseUid (mismo criterio que el resto de los modulos).
model Incident {
  id                 String           @id @default(uuid())
  organizationId     String           @map("organization_id")
  operatingCompanyId String           @map("operating_company_id")
  branchId           String           @map("branch_id")
  rentalId           String           @map("rental_id")
  returnId           String?          @map("return_id")
  type               IncidentType
  severity           IncidentSeverity
  status             IncidentStatus   @default(ABIERTA)
  description        String
  suggestion         String?
  reportedAt         DateTime         @map("reported_at")
  responsibleUserId  String           @map("responsible_user_id")
  resolutionSummary  String?          @map("resolution_summary")
  resolvedAt         DateTime?        @map("resolved_at")
  createdAt          DateTime         @default(now()) @map("created_at")
  createdBy          String           @map("created_by")
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at")
  updatedBy          String           @map("updated_by")
  version            Int              @default(1)

  operatingCompany Company       @relation(fields: [operatingCompanyId, organizationId], references: [id, organizationId])
  branch           Branch        @relation(fields: [branchId, operatingCompanyId], references: [id, companyId])
  rental           Rental        @relation(fields: [rentalId, operatingCompanyId], references: [id, operatingCompanyId])
  rentalReturn     RentalReturn? @relation(fields: [returnId, operatingCompanyId], references: [id, operatingCompanyId], onDelete: Restrict)

  actions IncidentAction[]

  @@index([organizationId, operatingCompanyId, branchId, status, createdAt(sort: Desc)], map: "incidents_scope_status_created_idx")
  @@index([rentalId, status], map: "incidents_rental_id_status_idx")
  @@index([returnId], map: "incidents_return_id_idx")
  @@map("incidents")
}

/// INC-02 - historial append-only de una incidencia: nunca se edita ni se borra una entrada, solo se agrega.
model IncidentAction {
  id           String             @id @default(uuid())
  incidentId   String             @map("incident_id")
  kind         IncidentActionKind
  description  String
  authorUserId String             @map("author_user_id")
  createdAt    DateTime           @default(now()) @map("created_at")

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)

  @@index([incidentId, createdAt], map: "incident_actions_incident_id_created_at_idx")
  @@map("incident_actions")
}

/// BDD-05 / SDD-05 / TDD-05 - Fuente de necesidad de la vacante (BR-REC-008).
enum VacancySource {
  RENUNCIA
  CRECIMIENTO
  NUEVA_AREA
}

/// BDD-05 / SDD-05 / TDD-05 - Ciclo de vida de la vacante.
enum VacancyStatus {
  NECESIDAD_REGISTRADA
  PUBLICADA
  EN_NEGOCIACION
  /// BDD-REC-001 §11.6 - "Entrevistado": hay al menos un candidato con entrevista realizada, en análisis.
  ENTREVISTADA
  DECIDIDA
  CANCELADA
  /// REC-02 "Pausar": convocatoria detenida temporalmente; se reanuda a PUBLICADA.
  PAUSADA
}

/// BDD-REC-001 §11.6 (Reclutamiento y Selección) - Estado de proceso del candidato, desde que está en contacto
/// hasta planilla. Convive con `CandidateStage` (columna Kanban de REC-03): la etapa es presentación del tablero,
/// el estado de proceso es la máquina de estados normativa. `PLANILLA -> Terminado` queda fuera (el BDD lo marca "futuro").
enum CandidateProcessState {
  EN_NEGOCIACION
  ENTREVISTADO
  DECIDIDO
  DESCARTADO
  INGRESADO
  PERIODO_PRUEBA
  PLANILLA
  TERMINADO
}

/// REC-04 - Resultado de una ronda de negociacion de condiciones (REC-P06/P07).
enum NegotiationOutcome {
  EN_CURSO
  ACORDADA
  NO_ACORDADA
}

/// BDD-05 / PROTO-REC-03 - Etapas de postulantes en el tablero Kanban.
enum CandidateStage {
  NUEVO
  CONTACTADO
  ENTREVISTA
  DECISION
}

/// BDD-05 / PROTO-REC-06 - Dictamen de contratación (exclusivo Gerencia/RRHH, BR-REC-003).
enum CandidateDecision {
  CONTRATADO
  RECHAZADO
}

/// BDD-05 / PROTO-REC-05 - Resultado de entrevista cualitativa (BR-REC-006).
enum InterviewResult {
  PENDIENTE
  AVANZA
  NO_AVANZA
}

/// BDD-REC-001 / SDD-REC-001 / PROTO-REC-01/02 - Agregado principal de Vacante.
/// Segregación multiempresa estricta: FKs compuestas hacia Company y Branch.
model Vacancy {
  id                  String         @id @default(uuid())
  organizationId      String         @map("organization_id")
  operatingCompanyId  String         @map("operating_company_id")
  branchId            String         @map("branch_id")
  code                String         @map("code")
  title               String         @db.VarChar(150)
  department          String         @db.VarChar(100)
  source              VacancySource
  status              VacancyStatus  @default(NECESIDAD_REGISTRADA)
  isMechanic          Boolean        @default(false) @map("is_mechanic")
  profileDescription String?        @map("profile_description") @db.Text
  baseSalary          Decimal?       @map("base_salary") @db.Decimal(10, 2)
  scheduleDetails     String?        @map("schedule_details") @db.VarChar(255)
  publishedChannels   String[]       @default([]) @map("published_channels")
  version             Int            @default(1)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  createdBy           String         @map("created_by")

  operatingCompany Company     @relation(fields: [operatingCompanyId, organizationId], references: [id, organizationId])
  branch           Branch      @relation(fields: [branchId, operatingCompanyId], references: [id, companyId])
  candidates       Candidate[]

  @@unique([operatingCompanyId, code], map: "vacancies_operating_company_id_code_key")
  @@index([organizationId, operatingCompanyId, branchId, status, createdAt(sort: Desc)], map: "vacancies_scope_status_created_idx")
  @@index([operatingCompanyId, createdAt(sort: Desc)], map: "vacancies_company_created_idx")
  @@map("vacancies")
}

/// BDD-REC-001 / SDD-REC-001 / PROTO-REC-03/04/06 - Agregado Postulante / Candidato.
/// Soporta modelo AS-IS flexible y deja campo `score` opcional para evolución formal TO-BE (DR-REC-001).
model Candidate {
  id                 String             @id @default(uuid())
  organizationId     String             @map("organization_id")
  operatingCompanyId String             @map("operating_company_id")
  vacancyId          String             @map("vacancy_id")
  fullName           String             @map("full_name") @db.VarChar(200)
  documentType       String             @default("DNI") @map("document_type") @db.VarChar(20)
  documentNumber     String             @map("document_number") @db.VarChar(30)
  email              String?            @db.VarChar(150)
  phone              String?            @db.VarChar(50)
  cvDocumentId       String             @map("cv_document_id")
  salaryExpectation  Decimal?           @map("salary_expectation") @db.Decimal(10, 2)
  /// DAT-REC-004 - Archivo del CV en almacenamiento privado (URL de objeto; la lectura es por URL firmada).
  cvObjectUrl        String?            @map("cv_object_url") @db.VarChar(1024)
  cvFileName         String?            @map("cv_file_name") @db.VarChar(200)
  cvContentType      String?            @map("cv_content_type") @db.VarChar(100)
  cvSizeBytes        Int?               @map("cv_size_bytes")
  cvUploadedAt       DateTime?          @map("cv_uploaded_at")
  cvUploadedBy       String?            @map("cv_uploaded_by")
  stage              CandidateStage     @default(NUEVO)
  /// BDD-REC-001 §11.6 - Estado normativo del proceso (ver enum CandidateProcessState).
  processState          CandidateProcessState @default(EN_NEGOCIACION) @map("process_state")
  processStateChangedAt DateTime?             @map("process_state_changed_at")
  score              Decimal?           @db.Decimal(5, 2)
  decision           CandidateDecision?
  decisionNotes      String?            @map("decision_notes") @db.Text
  decidedBy          String?            @map("decided_by")
  decidedAt          DateTime?          @map("decided_at")
  version            Int                @default(1)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  vacancy    Vacancy              @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  interviews   CandidateInterview[]
  negotiations CandidateNegotiation[]
  onboarding   EmployeeOnboarding?
  employee     Employee?

  @@unique([vacancyId, documentNumber], map: "candidates_vacancy_id_document_number_key")
  @@index([vacancyId, stage], map: "candidates_vacancy_id_stage_idx")
  @@index([vacancyId, processState], map: "candidates_vacancy_id_process_state_idx")
  @@map("candidates")
}

/// BDD-REC-001 REC-P08 / PROTO-REC-05 - Entrevista cualitativa a candidato.
model CandidateInterview {
  id               String          @id @default(uuid())
  candidateId      String          @map("candidate_id")
  scheduledAt      DateTime        @map("scheduled_at")
  isVirtual        Boolean         @default(true) @map("is_virtual")
  meetUrl          String?         @map("meet_url") @db.VarChar(255)
  location         String?         @db.VarChar(255)
  interviewerId    String          @map("interviewer_id")
  qualitativeNotes String?         @map("qualitative_notes") @db.Text
  result           InterviewResult @default(PENDIENTE)
  evaluatedAt      DateTime?       @map("evaluated_at")
  createdAt        DateTime        @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, scheduledAt], map: "candidate_interviews_candidate_id_scheduled_at_idx")
  @@map("candidate_interviews")
}

/// BDD-REC-001 REC-P06/P07 / PROTO-REC-04 - Historial append-only de rondas de negociacion de condiciones.
/// Dato sensible (DAT-REC-003): solo lo ve quien tiene VIEW_CANDIDATE_SENSITIVE_DATA.
model CandidateNegotiation {
  id                    String             @id @default(uuid())
  candidateId           String             @map("candidate_id")
  offeredSalary         Decimal            @map("offered_salary") @db.Decimal(10, 2)
  offeredSchedule       String?            @map("offered_schedule") @db.VarChar(255)
  offeredOtherConditions String?           @map("offered_other_conditions") @db.Text
  candidateSalary       Decimal?           @map("candidate_salary") @db.Decimal(10, 2)
  candidateSchedule     String?            @map("candidate_schedule") @db.VarChar(255)
  candidateOtherConditions String?         @map("candidate_other_conditions") @db.Text
  candidateStartDate    DateTime?          @map("candidate_start_date") @db.Date
  outcome               NegotiationOutcome @default(EN_CURSO)
  agreedSalary          Decimal?           @map("agreed_salary") @db.Decimal(10, 2)
  agreedConditions      String?            @map("agreed_conditions") @db.Text
  reason                String?            @db.Text
  recordedBy            String             @map("recorded_by")
  createdAt             DateTime           @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, createdAt(sort: Desc)], map: "candidate_negotiations_candidate_id_created_at_idx")
  @@map("candidate_negotiations")
}

/// BDD-REC-001 REC-P11..P15 / PROTO-REC-07/08 - Incorporación y periodo de prueba.
/// Exige contrato notariado mandatorio si la vacante fue para mecánico (BR-REC-009).
model EmployeeOnboarding {
  id                       String    @id @default(uuid())
  candidateId              String    @unique @map("candidate_id")
  startDate                DateTime  @map("start_date") @db.Date
  inductionScheduled       Boolean   @default(false) @map("induction_scheduled")
  equipmentAssigned        Boolean   @default(false) @map("equipment_assigned")
  responsibilityCardSigned Boolean   @default(false) @map("responsibility_card_signed")
  notarizedContractSigned  Boolean   @default(false) @map("notarized_contract_signed")
  isCompleted              Boolean   @default(false) @map("is_completed")
  completedAt              DateTime? @map("completed_at")
  completedBy              String?   @map("completed_by")
  probationEvaluation      String?   @map("probation_evaluation") @db.Text
  probationPassed          Boolean?  @map("probation_passed")
  probationEvaluatedAt     DateTime? @map("probation_evaluated_at")
  probationEvaluatedBy     String?   @map("probation_evaluated_by")
  /// REC-08 / BR-REC-005 - Honorarios del periodo de prueba (dato financiero, DAT-REC-007).
  probationMonthlyFee      Decimal?  @map("probation_monthly_fee") @db.Decimal(10, 2)
  postProbationMonthlySalary Decimal? @map("post_probation_monthly_salary") @db.Decimal(10, 2)
  probationFeeNotes        String?   @map("probation_fee_notes") @db.VarChar(500)
  probationFeesRecordedAt  DateTime? @map("probation_fees_recorded_at")
  probationFeesRecordedBy  String?   @map("probation_fees_recorded_by")
  version                  Int       @default(1)
  createdAt                DateTime  @default(now()) @map("created_at")

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@map("employee_onboardings")
}

// =============================================================================
// MODULO 06: ADMINISTRACIÓN DE PERSONAL (ADP-01 a ADP-10)
// Fuentes canónicas: BDD-06 (BDD-ADP-001 v1.9), SDD-06 (v2.1), TDD-06 (v2.1)
// =============================================================================

enum EmployeeStatus {
  PERIODO_PRUEBA
  PLANILLA
  TERMINADO
}

enum TerminationReason {
  RENUNCIA
  DESPIDO
}

enum AttendanceStatus {
  PRESENTE
  TARDANZA
  FALTA_JUSTIFICADA
  FALTA_INJUSTIFICADA
  PERMISO
}

enum LeaveType {
  PERMISO_HORAS
  SALIDA_ANTES_DE_HORA
  LICENCIA_MEDICA
  PERSONAL
}

enum LeaveStatus {
  SOLICITADO
  AUTORIZADO
  DENEGADO
}

enum VacationStatus {
  SOLICITADA
  PROGRAMADA
  REPROGRAMADA
  CANCELADA
  COMPLETADA
}

enum FieldTripStatus {
  PENDIENTE_NIVEL_1
  PENDIENTE_NIVEL_2
  PENDIENTE_NIVEL_3
  AUTORIZADA
  NO_AUTORIZADA
  CERRADA_NORMAL
  OBSERVADA
}

/// BDD-ADP-001 / SDD-06 / TDD-06 - Agregado principal de Colaborador / Empleado.
/// Segregación multiempresa estricta: FKs compuestas hacia Company y Branch.
model Employee {
  id                    String             @id @default(uuid())
  organizationId        String             @map("organization_id")
  operatingCompanyId    String             @map("operating_company_id")
  branchId              String             @map("branch_id")
  candidateId           String?            @unique @map("candidate_id")
  documentType          String             @default("DNI") @map("document_type") @db.VarChar(20)
  documentNumber        String             @map("document_number") @db.VarChar(30)
  fullName              String             @map("full_name") @db.VarChar(200)
  email                 String?            @db.VarChar(150)
  phone                 String?            @db.VarChar(50)
  areaId                String             @map("area_id") @db.VarChar(100)
  areaName              String             @map("area_name") @db.VarChar(100)
  jobTitle              String             @map("job_title") @db.VarChar(150)
  status                EmployeeStatus     @default(PERIODO_PRUEBA)
  hireDate              DateTime           @map("hire_date") @db.Date
  probationEvaluatedAt  DateTime?          @map("probation_evaluated_at")
  probationPassed       Boolean?           @map("probation_passed")
  payrollStartedAt      DateTime?          @map("payroll_started_at")
  terminatedAt          DateTime?          @map("terminated_at")
  terminationReason     TerminationReason? @map("termination_reason")
  terminationNoticeDays Int?               @map("termination_notice_days")
  terminationNotes      String?            @map("termination_notes") @db.Text
  fieldTripLateCount    Int                @default(0) @map("field_trip_late_count")
  isFieldTripObserved   Boolean            @default(false) @map("is_field_trip_observed")
  baseSalary            Decimal?           @map("base_salary") @db.Decimal(10, 2)
  /// Cuenta de acceso (Firebase) del colaborador: permite que un trabajador de campo encuentre su propia ficha
  /// (`GET /me/employee`) sin elegir empleado a mano. Un usuario, como máximo un colaborador por empresa.
  firebaseUid           String?            @map("firebase_uid") @db.VarChar(128)
  version               Int                @default(1)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  operatingCompany Company                 @relation(fields: [operatingCompanyId, organizationId], references: [id, organizationId])
  branch           Branch                  @relation(fields: [branchId, operatingCompanyId], references: [id, companyId])
  candidate        Candidate?              @relation(fields: [candidateId], references: [id])
  attendance       AttendanceRecord[]
  leaves           LeaveRequest[]
  vacations        VacationRequest[]
  fieldTrips       FieldTripRequest[]
  termination      EmploymentTermination?
  memos            HrMemo[]
  trainings        TrainingAttendee[]

  @@unique([operatingCompanyId, documentNumber], map: "employees_company_document_key")
  @@unique([operatingCompanyId, firebaseUid], map: "employees_company_firebase_uid_key")
  @@index([organizationId, operatingCompanyId, branchId, status], map: "employees_scope_status_idx")
  @@index([areaId, status], map: "employees_area_status_idx")
  @@map("employees")
}

/// BDD-ADP-001 ADP-P01..04 / BR-ADP-001 - Registro diario de asistencia y faltas.
model AttendanceRecord {
  id                 String           @id @default(uuid())
  employeeId         String           @map("employee_id")
  date               DateTime         @map("date") @db.Date
  checkInTime        DateTime?        @map("check_in_time")
  checkOutTime       DateTime?        @map("check_out_time")
  status             AttendanceStatus @default(PRESENTE)
  minutesLate        Int              @default(0) @map("minutes_late")
  deductionAmount    Decimal          @default(0) @map("deduction_amount") @db.Decimal(10, 2)
  isDeductionApplied Boolean          @default(false) @map("is_deduction_applied")
  payrollMonth       String?          @map("payroll_month") @db.VarChar(7)
  deductionAppliedAt DateTime?        @map("deduction_applied_at")
  notes              String?          @db.Text
  /// ADP-03: justificación con la que se reclasificó la falta (JUSTIFICADA / INJUSTIFICADA).
  justification      String?          @db.Text
  reclassifiedAt     DateTime?        @map("reclassified_at")
  reclassifiedById   String?          @map("reclassified_by_id")
  /// DEC-ADP-ATT-EVIDENCE-001: evidencia fotografica (foto con reloj+hora+rostro enviada al grupo de WhatsApp). Opcional.
  evidenceKind               String?   @map("evidence_kind") @db.VarChar(30)
  evidenceStorageRef         String?   @map("evidence_storage_ref") @db.Text
  evidenceUrl                String?   @map("evidence_url") @db.Text
  evidenceCapturedAt         DateTime? @map("evidence_captured_at")
  evidenceNote               String?   @map("evidence_note") @db.Text
  evidenceCorroboratedById   String?   @map("evidence_corroborated_by_id")
  evidenceCorroboratedAt     DateTime? @map("evidence_corroborated_at")
  /// HU-29 (Respuestas 2026-10-20 #20): ubicacion automatica opcional (WGS84) al registrar la asistencia; nunca bloquea el registro.
  latitude           Float?
  longitude          Float?
  /// Precision horizontal reportada por el dispositivo, en metros.
  accuracy           Float?           @map("accuracy_meters")
  createdById        String           @map("created_by_id")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date], map: "attendance_records_employee_date_key")
  @@index([employeeId, payrollMonth], map: "attendance_records_employee_payroll_month_idx")
  @@index([date, status], map: "attendance_records_date_status_idx")
  @@map("attendance_records")
}

/// BDD-ADP-001 ADP-P05..06 / BR-ADP-003 - Solicitud y autorización de permisos.
model LeaveRequest {
  id              String      @id @default(uuid())
  employeeId      String      @map("employee_id")
  type            LeaveType
  date            DateTime    @map("date") @db.Date
  startTime       DateTime?   @map("start_time")
  endTime         DateTime?   @map("end_time")
  reason          String      @db.Text
  status          LeaveStatus @default(SOLICITADO)
  authorizedById  String?     @map("authorized_by_id")
  authorizedByName String?    @map("authorized_by_name") @db.VarChar(200)
  resolutionNotes String?     @map("resolution_notes") @db.Text
  resolvedAt      DateTime?   @map("resolved_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  evidence LeaveEvidence[]

  @@index([employeeId, date], map: "leave_requests_employee_date_idx")
  @@index([status, date], map: "leave_requests_status_date_idx")
  @@map("leave_requests")
}

/// BDD-ADP-001 ADP-P09..10 / BR-ADP-002 / DR-ADP-001 - Programación de vacaciones con capacidad de área.
model VacationRequest {
  id          String         @id @default(uuid())
  employeeId  String         @map("employee_id")
  /// BR-ADP-002 por EMPRESA (Respuestas 2026-10-20 #18): empresa del colaborador, desnormalizada para la EXCLUDE.
  operatingCompanyId String  @map("operating_company_id")
  areaId      String         @map("area_id") @db.VarChar(100)
  startDate   DateTime       @map("start_date") @db.Date
  endDate     DateTime       @map("end_date") @db.Date
  status      VacationStatus @default(SOLICITADA)
  requestedAt DateTime       @default(now()) @map("requested_at")
  approvedById String?       @map("approved_by_id")
  approvedAt  DateTime?      @map("approved_at")
  notes       String?        @db.Text
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // BR-ADP-002: EXCLUDE USING gist (operating_company_id WITH =, area_id WITH =, daterange(start_date, end_date, '[]') WITH &&)
  // WHERE status IN ('PROGRAMADA','REPROGRAMADA') — creada en 20261008000001 y hecha POR EMPRESA en 20261021010002.
  @@index([areaId, status, startDate, endDate], map: "vacation_requests_area_status_dates_idx")
  @@index([operatingCompanyId, areaId, status, startDate, endDate], map: "vacation_requests_company_area_status_idx")
  @@index([employeeId, status], map: "vacation_requests_employee_status_idx")
  @@map("vacation_requests")
}

/// BDD-ADP-001 ADP-P12..14 / BR-ADP-004 / BR-ADP-005 - Cascada de salidas a campo (3 niveles, sin 4to).
model FieldTripRequest {
  id                 String          @id @default(uuid())
  employeeId         String          @map("employee_id")
  destination        String          @db.VarChar(255)
  objective          String          @db.Text
  estimatedDeparture DateTime        @map("estimated_departure")
  estimatedReturn    DateTime        @map("estimated_return")
  actualDeparture    DateTime?       @map("actual_departure")
  actualReturn       DateTime?       @map("actual_return")
  status             FieldTripStatus @default(PENDIENTE_NIVEL_1)
  authorizationLevel Int?            @map("authorization_level")
  authorizedById     String?         @map("authorized_by_id")
  authorizedByName   String?         @map("authorized_by_name") @db.VarChar(200)
  authorizedAt       DateTime?       @map("authorized_at")
  level1TimeoutAt    DateTime?       @map("level1_timeout_at")
  level2TimeoutAt    DateTime?       @map("level2_timeout_at")
  level3TimeoutAt    DateTime?       @map("level3_timeout_at")
  lateMinutes        Int             @default(0) @map("late_minutes")
  returnNotes        String?         @map("return_notes") @db.Text
  /// ADP-07: rechazo explícito de un autorizador (el estado resultante es NO_AUTORIZADA, igual que si nadie responde).
  rejectedById       String?         @map("rejected_by_id")
  rejectedByName     String?         @map("rejected_by_name") @db.VarChar(200)
  rejectedAt         DateTime?       @map("rejected_at")
  rejectedAtLevel    Int?            @map("rejected_at_level")
  rejectionReason    String?         @map("rejection_reason") @db.Text
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, status], map: "field_trips_employee_status_idx")
  @@index([status, createdAt], map: "field_trips_status_created_idx")
  @@map("field_trip_requests")
}

/// BDD-ADP-001 ADP-P15..17 / BR-ADP-006 / ADR-KAI-006 - Término de relación laboral.
model EmploymentTermination {
  id                  String            @id @default(uuid())
  employeeId          String            @unique @map("employee_id")
  reason              TerminationReason
  noticeDays          Int               @default(0) @map("notice_days")
  finalSettlementPaid Boolean           @default(false) @map("final_settlement_paid")
  settlementAmount    Decimal           @default(0) @map("settlement_amount") @db.Decimal(10, 2)
  notes               String?           @db.Text
  terminatedById      String            @map("terminated_by_id")
  terminatedAt        DateTime          @default(now()) @map("terminated_at")
  createdAt           DateTime          @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@map("employment_terminations")
}

/// BDD-ADP-001 ADP-P04 / ADP-08 (evidencia adjunta de permisos, ADP-04) - archivo ya subido a almacenamiento con URL firmada.
model LeaveEvidence {
  id            String   @id @default(uuid())
  leaveId       String   @map("leave_id")
  objectUrl     String   @map("object_url") @db.Text
  contentType   String   @map("content_type") @db.VarChar(100)
  uploadedById  String   @map("uploaded_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  leave LeaveRequest @relation(fields: [leaveId], references: [id], onDelete: Cascade)

  @@unique([leaveId, objectUrl], map: "leave_evidence_leave_object_key")
  @@index([leaveId], map: "leave_evidence_leave_idx")
  @@map("leave_evidence")
}

/// BDD-ADP-001 ADP-P03 / BR-ADP-005 - Memorando de advertencia generado automáticamente por reincidencia
/// (4ª tardanza al regresar de campo, 2ª falta injustificada del mes). `sourceType + sourceId` lo hace idempotente.
model HrMemo {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  employeeId      String   @map("employee_id")
  kind            String   @db.VarChar(40)
  sourceType      String   @map("source_type") @db.VarChar(40)
  sourceId        String   @map("source_id")
  violationNumber Int      @map("violation_number")
  reason          String   @db.Text
  issuedOn        DateTime @map("issued_on") @db.Date
  generatedBy     String   @default("SISTEMA") @map("generated_by") @db.VarChar(40)
  createdAt       DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([sourceType, sourceId], map: "hr_memos_source_key")
  @@index([employeeId, issuedOn], map: "hr_memos_employee_issued_idx")
  @@map("hr_memos")
}

/// BDD-ADP-001 ADP-P19 / BR-ADP-008 / DAT-ADP-009 - Taller interno informal (~1 h): tema, asistentes y nota cualitativa
/// de comprensión. NO es la evaluación de desempeño formal (fuera del MVP, BR-ADP-007).
model TrainingSession {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  operatingCompanyId String   @map("operating_company_id")
  branchId           String   @map("branch_id")
  topic              String   @db.VarChar(200)
  heldOn             DateTime @map("held_on") @db.Date
  durationMinutes    Int      @default(60) @map("duration_minutes")
  comprehensionNotes String?  @map("comprehension_notes") @db.Text
  createdById        String   @map("created_by_id")
  createdAt          DateTime @default(now()) @map("created_at")

  attendees TrainingAttendee[]

  @@index([operatingCompanyId, heldOn], map: "training_sessions_company_held_idx")
  @@map("training_sessions")
}

model TrainingAttendee {
  trainingId String @map("training_id")
  employeeId String @map("employee_id")

  training TrainingSession @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([trainingId, employeeId])
  @@index([employeeId], map: "training_attendees_employee_idx")
  @@map("training_attendees")
}

/// TR-08 / SDD-KAIROS-TRANSVERSAL 17 - estado de sincronizacion offline de un checklist (ENTREGA o RECEPCION) tal como
/// lo CONFIRMA el servidor. `fields` guarda cada campo con su revision (merge por campo); `evidence` es el manifiesto
/// aditivo de tomas (zona+slot, contentHash). `status` solo es SYNCED si no hay conflictos abiertos. Sin FK a
/// rentals/returns (el expediente es polimorfico: `source_id` = rental_id o return_id). Ver migracion 20261019000400.
model SyncChecklistState {
  id                 String    @id @default(uuid())
  organizationId     String    @map("organization_id")
  operatingCompanyId String    @map("operating_company_id")
  branchId           String    @map("branch_id")
  /// ENTREGA | RECEPCION (CHECK en la migracion)
  checklistType      String    @map("checklist_type")
  sourceId           String    @map("source_id")
  /// Alquiler asociado (para auditoria): = source_id en ENTREGA, returns.rental_id en RECEPCION.
  rentalId           String    @map("rental_id")
  /// SYNCED | SYNC_CONFLICT (CHECK en la migracion)
  status             String    @default("SYNCED")
  version            Int       @default(1)
  fields             Json      @default("{}")
  evidence           Json      @default("[]")
  serverConfirmedAt  DateTime? @map("server_confirmed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at")

  conflicts SyncConflict[]

  @@unique([checklistType, sourceId], map: "sync_checklist_states_type_source_key")
  @@index([organizationId, operatingCompanyId, status], map: "idx_sync_states_scope_status")
  @@map("sync_checklist_states")
}

/// TR-08 - conflicto de sincronizacion (un dato en conflicto = un registro). Nunca se borra: RESOLVED conserva
/// ambas versiones, quien resolvio, la accion y el `reason` (siempre auditado). Indice unico parcial (state_id, kind,
/// key) WHERE status = 'OPEN' en la migracion.
model SyncConflict {
  id                 String    @id @default(uuid())
  stateId            String    @map("state_id")
  organizationId     String    @map("organization_id")
  operatingCompanyId String    @map("operating_company_id")
  branchId           String    @map("branch_id")
  checklistType      String    @map("checklist_type")
  sourceId           String    @map("source_id")
  rentalId           String    @map("rental_id")
  /// FIELD | EVIDENCE
  kind               String
  /// Campo del checklist, o `zona#slot`
  key                String
  serverVersion      Json      @map("server_version")
  localVersion       Json      @map("local_version")
  localBaseRev       Int?      @map("local_base_rev")
  /// OPEN | RESOLVED
  status             String    @default("OPEN")
  /// KEEP_LOCAL | KEEP_SERVER | MERGE
  resolution         String?
  reason             String?
  detectedBy         String    @map("detected_by")
  deviceId           String?   @map("device_id")
  resolvedBy         String?   @map("resolved_by")
  resolvedAt         DateTime? @map("resolved_at")
  version            Int       @default(1)
  createdAt          DateTime  @default(now()) @map("created_at")

  state SyncChecklistState @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@index([stateId, status], map: "idx_sync_conflicts_state_status")
  @@index([organizationId, operatingCompanyId, checklistType, sourceId, status], map: "idx_sync_conflicts_scope_source")
  @@map("sync_conflicts")
}

/// H-02 (19 oct 2026) / DEC-ADP-AREAS-001 - catalogo de areas de RR.HH. por empresa (dato de referencia). La semilla trae SOLO
/// las areas documentadas en el organigrama oficial (Inventario de Procesos, 17 ago). `Employee.areaId` guarda el `code` del
/// catalogo cuando el area viene de el; el texto libre sigue permitido por compatibilidad (sin FK a proposito).
model HrArea {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  operatingCompanyId String   @map("operating_company_id")
  code               String   @db.VarChar(100)
  name               String   @db.VarChar(100)
  description        String?  @db.VarChar(255)
  sortOrder          Int      @default(0) @map("sort_order")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  operatingCompany Company @relation(fields: [operatingCompanyId, organizationId], references: [id, organizationId])

  @@unique([operatingCompanyId, code], map: "hr_areas_company_code_key")
  @@index([organizationId, operatingCompanyId, isActive], map: "hr_areas_scope_active_idx")
  @@map("hr_areas")
}
