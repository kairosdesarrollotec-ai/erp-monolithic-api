{
  "name": "@kairos/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --experimental-require-module\" jest --no-watchman",
    "test:e2e": "NODE_OPTIONS=\"--experimental-vm-modules --experimental-require-module\" jest --no-watchman --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "test:integration": "NODE_OPTIONS=\"--experimental-vm-modules --experimental-require-module\" jest --no-watchman --config ./test/jest-integration.json"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.2.0",
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@prisma/client": "^5.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "firebase-admin": "^14.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.7.4",
    "@eslint/js": "^9.39.5",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "js-yaml": "^5.4.2",
    "prisma": "^5.20.0",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "setupFilesAfterEnv": [
      "<rootDir>/jest-esm-globals.ts"
    ],
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": {
            "module": "ESNext",
            "moduleResolution": "bundler",
            "types": [
              "jest",
              "node"
            ]
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^jose$": "<rootDir>/__stubs__/jose.cjs",
      "config/firebase-admin\\.config$": "<rootDir>/__stubs__/firebase-admin.config.cjs",
      "^firebase-admin/messaging$": "<rootDir>/__stubs__/firebase-admin-messaging.ts",
      "^firebase-admin/auth$": "<rootDir>/__stubs__/firebase-admin-auth.ts"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/__stubs__/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
