# Postgres local (docker-compose.yml en la raiz del repo)
DATABASE_URL="postgresql://kairos:kairos_dev@localhost:5432/kairos_dev"
# Conexion directa (sin PgBouncer) usada por prisma migrate (schema.prisma `directUrl`). En local = igual a DATABASE_URL.
DIRECT_URL="postgresql://kairos:kairos_dev@localhost:5432/kairos_dev"

# Puerto HTTP de la API (default 3000)
PORT=3000

# Firebase Authentication (Identity Platform) - Admin SDK
# Estas 3 variables definen A QUE PROYECTO DE FIREBASE apunta el backend.
# No hay distincion de codigo entre "dev" y "productivo": el mismo backend
# apunta a uno u otro solo segun el valor de estas variables de entorno.
# En local, mientras no se decida un proyecto Firebase de desarrollo propio,
# se puede apuntar directo al proyecto productivo indicado por el equipo -
# nunca commitear estos valores reales, solo van en el .env local (gitignorado).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Resend - servicio de envio de correo transaccional (ADM-01 / TR-02)
# API key obtenible en https://resend.com/api-keys
# El dominio remitente debe estar verificado en Resend.
RESEND_API_KEY=
EMAIL_FROM=no-reply@kairosnexo.com

# URL base de la aplicacion web (incluida en el boton del correo de bienvenida)
APP_BASE_URL=https://kairos-nexo-dev.web.app/

# Google Cloud Storage — fotos de catálogo de vehículos (ADR-KAI-005 extendido a Fleet, PROP-008)
# GCS_BUCKET_NAME es obligatorio para que POST /fleet/vehicles/photo-upload-sessions funcione.
# GCS_CLIENT_EMAIL y GCS_PRIVATE_KEY son opcionales: si no se configuran, se usan los valores de
# FIREBASE_CLIENT_EMAIL y FIREBASE_PRIVATE_KEY (la cuenta de servicio debe tener rol Storage Object Admin).
GCS_BUCKET_NAME=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY=

# CORS — orígenes permitidos separados por coma (F2 — TDD-00 §8.1)
# Ejemplo: https://kairos-nexo-dev.web.app,https://kairos-nexo.web.app
# Dejar vacío desactiva CORS (solo para herramientas CLI/server-to-server)
ALLOWED_ORIGINS=https://kairos-nexo-dev.web.app

# Retencion (L-02, 16-oct-2026): purga por lotes de idempotency_keys y outbox_events. audit_events NO se purga.
# RETENTION_PURGE_ENABLED=false (u off/0/no, sin distinguir mayusculas) desactiva el job; por defecto esta activo. Nunca corre bajo Jest.
# Plazos en dias (minimo 7; un valor invalido cae al default). El TTL de replay de idempotencia sigue siendo 24 h.
RETENTION_PURGE_ENABLED=true
RETENTION_IDEMPOTENCY_DAYS=365
RETENTION_OUTBOX_PROCESSED_DAYS=365
RETENTION_OUTBOX_DEAD_LETTER_DAYS=365
# Items de tablero ya vistos (descartados/atendidos) se purgan tras N dias (minimo 7). Los NO vistos nunca se purgan.
RETENTION_DASHBOARD_SEEN_DAYS=30
RETENTION_PURGE_BATCH_SIZE=500
RETENTION_PURGE_MAX_BATCHES_PER_RUN=200
RETENTION_PURGE_BATCH_PAUSE_MS=100
RETENTION_PURGE_INTERVAL_MS=21600000
RETENTION_PURGE_INITIAL_DELAY_MS=300000

# Devolucion: programadores en el proceso de la API (nunca arrancan bajo Jest). false|off|0|no = desactivado (sin distinguir mayusculas); lo demas = activo.
# RETURN_REMINDER_SCHEDULER: recordatorio 3 h antes (BR-DEV-004). RETURN_ALERT_SCHEDULER: alerta de garantia 24 h al tablero de Finanzas (DEC-DEVREM-002).
# Intervalo en ms (default 300000 = 5 min). Ambos son idempotentes y seguros con varias replicas.
RETURN_REMINDER_SCHEDULER=on
RETURN_ALERT_SCHEDULER=on
# RETURN_REMINDER_INTERVAL_MS=300000
# RETURN_ALERT_INTERVAL_MS=300000

# Interruptores (todos): false|off|0|no = apagado; cualquier otro valor = encendido; vacio = default de cada uno (DEC-OPS-FLAGS-001).

# RRHH: cascada automatica de comisiones de campo vencidas (default activo; intervalo en ms, default 60000)
HR_FIELD_TRIP_CASCADE_SCHEDULER=on
# HR_FIELD_TRIP_CASCADE_INTERVAL_MS=60000

# Alquiler: tarifa diaria del conductor de la empresa. Normalmente se digita a mano por alquiler (obligatoria para completar la
# entrega); este valor de entorno es solo un respaldo de referencia. Vacio = sin tarifa de entorno. Moneda PEN (default) o USD.
# COMPANY_DRIVER_DAILY_RATE=
# COMPANY_DRIVER_DAILY_RATE_CURRENCY=PEN

# Relay del outbox hacia el tablero (dashboard-projections). Todos opcionales; entre parentesis el default.
# OUTBOX_RELAY_INTERVAL_MS=5000          (cada cuanto sondea, ms)
# OUTBOX_RELAY_BATCH_SIZE=50             (eventos por ciclo)
# OUTBOX_RELAY_LEASE_MS=30000            (arrendamiento de un evento en proceso, ms)
# OUTBOX_RELAY_BASE_BACKOFF_MS=5000      (espera inicial entre reintentos, ms)
# OUTBOX_RELAY_MAX_BACKOFF_MS=300000     (tope de la espera, ms)
# OUTBOX_RELAY_MAX_ATTEMPTS=10           (intentos antes de dead-letter)

# Plantillas de documentos: tamano maximo de subida en bytes (default 20971520 = 20 MB)
# TEMPLATES_UPLOAD_MAX_BYTES=20971520

# Cotizacion provisional: solo con "true" se permiten los adaptadores provisionales en produccion (default: no)
# KAIROS_ALLOW_PROVISIONAL_QUOTING=false
