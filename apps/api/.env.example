# Postgres local (docker-compose.yml en la raiz del repo)
DATABASE_URL="postgresql://kairos:kairos_dev@localhost:5432/kairos_dev"

PORT=3000

# Firebase Authentication (Identity Platform) - Admin SDK
# Estas 3 variables definen A QUE PROYECTO DE FIREBASE apunta el backend.
# No hay distincion de codigo entre "dev" y "productivo": el mismo backend
# apunta a uno u otro solo segun el valor de estas variables de entorno.
# En local, mientras no se decida un proyecto Firebase de desarrollo propio,
# se puede apuntar directo al proyecto productivo indicado por el equipo -
# nunca commitear estos valores reales, solo van en el .env local (gitignorado).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
