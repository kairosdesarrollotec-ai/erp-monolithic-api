{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-claude-syntax.sh \"$CLAUDE_FILE_PATH\""
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-no-secrets.sh \"$CLAUDE_FILE_PATH\""
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-missing-references.sh \"$CLAUDE_FILE_PATH\""
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-screen-without-baseline.sh \"$CLAUDE_FILE_PATH\""
          }
        ]
      }
    ]
  }
}
