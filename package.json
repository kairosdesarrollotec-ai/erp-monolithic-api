{
  "name": "kairos-erp",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  },
  "scripts": {
    "dev:api": "npm run start:dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build:api": "npm run build --workspace apps/api",
    "build:web": "npm run build --workspace apps/web",
    "test:api": "npm run test --workspace apps/api",
    "test:web": "npm run test --workspace apps/web",
    "lint": "npm run lint --workspaces --if-present",
    "test:integration:api": "npm run test:integration --workspace apps/api",
    "seed:platform-admin": "ts-node -P apps/api/tsconfig.json scripts/seed-platform-admin.ts",
    "audit:prod": "node scripts/audit-check.mjs",
    "audit:all": "node scripts/audit-check.mjs --include-dev"
  },
  "dependencies": {
    "resend": "^6.30.0"
  }
}
